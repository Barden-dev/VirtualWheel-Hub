    <sys:String x:Key="Tour_Open">Getting started</sys:String>
    <sys:String x:Key="Tour_Example">ILLUSTRATION — not your current game status</sys:String>
    <sys:String x:Key="Tour_Progress">STEP {0} OF {1}</sys:String>
    <sys:String x:Key="Tour_Start">Take the tour</sys:String>
    <sys:String x:Key="Tour_Next">Next</sys:String>
    <sys:String x:Key="Tour_Back">Back</sys:String>
