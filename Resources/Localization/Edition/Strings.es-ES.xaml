  <sys:String x:Key="Offer_AbsInfo" xml:space="preserve">Reduce la potencia del freno cuando las ruedas se bloquean.</sys:String>
  <sys:String x:Key="Offer_Tc" xml:space="preserve">Asistente TC</sys:String>
  <sys:String x:Key="Offer_TcInfo" xml:space="preserve">Reduce la salida del acelerador cuando las ruedas patinan.</sys:String>
  <sys:String x:Key="Offer_Speed" xml:space="preserve">Dirección consciente de la velocidad</sys:String>
  <sys:String x:Key="Offer_SpeedInfo" xml:space="preserve">Ajusta la respuesta de la dirección utilizando la velocidad actual del juego.</sys:String>
  <sys:String x:Key="Offer_Slip" xml:space="preserve">Umbral de deslizamiento</sys:String>
