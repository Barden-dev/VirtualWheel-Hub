  <sys:String x:Key="Offer_DataInfo" xml:space="preserve">Los datos del juego permiten la selección automática de automóviles y asistentes de conducción compatibles.</sys:String>
  <sys:String x:Key="Offer_Prepare" xml:space="preserve">preparar el juego</sys:String>
