  <sys:String x:Key="InputFix_Title" xml:space="preserve">LMU — compatibilidade de entrada</sys:String>
  <sys:String x:Key="InputFix_Description" xml:space="preserve">Habilite DirectInput Fallback para taxas de entrada de até 1000 Hz. Feche o jogo antes de aplicar. O arquivo de configurações original é copiado.</sys:String>
