  <sys:String x:Key="Offer_AbsInfo" xml:space="preserve">Réduit la puissance de freinage lorsque les roues se bloquent.</sys:String>
  <sys:String x:Key="Offer_Tc" xml:space="preserve">Assistant TC</sys:String>
  <sys:String x:Key="Offer_TcInfo" xml:space="preserve">Réduit la puissance de l’accélérateur lorsque les roues patinent.</sys:String>
  <sys:String x:Key="Offer_Speed" xml:space="preserve">Direction sensible à la vitesse</sys:String>
  <sys:String x:Key="Offer_SpeedInfo" xml:space="preserve">Ajuste la réponse de la direction en utilisant la vitesse de jeu actuelle.</sys:String>
  <sys:String x:Key="Offer_Slip" xml:space="preserve">Seuil de glissement</sys:String>
  <sys:String x:Key="Offer_Drop" xml:space="preserve">Réduction maximale (%)</sys:String>
