  <sys:String x:Key="Offer_DataTab" xml:space="preserve">Connexion au jeu · PRO</sys:String>
  <sys:String x:Key="Offer_DataInfo" xml:space="preserve">Les données de jeu permettent une sélection automatique des voitures et des assistants de conduite pris en charge.</sys:String>
  <sys:String x:Key="Offer_Prepare" xml:space="preserve">Préparer le jeu</sys:String>
  <sys:String x:Key="Offer_Menu" xml:space="preserve">Menus de jeu</sys:String>
  <sys:String x:Key="Offer_MenuInfo" xml:space="preserve">Utilisez l'état connu du menu du jeu pour suspendre les commandes et relâcher le curseur.</sys:String>
