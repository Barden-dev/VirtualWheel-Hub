  <sys:String x:Key="Offer_Sound" xml:space="preserve">Retour sonore</sys:String>
  <sys:String x:Key="Offer_SoundTab" xml:space="preserve">Audio · PRO</sys:String>
  <sys:String x:Key="Offer_SoundInfo" xml:space="preserve">Écoutez les changements d’adhérence et l’activité d’assistance pendant la conduite.</sys:String>
  <sys:String x:Key="Offer_Volume" xml:space="preserve">Volumes (%)</sys:String>
  <sys:String x:Key="Offer_Pitch" xml:space="preserve">Pas (Hz)</sys:String>
  <sys:String x:Key="Offer_Front" xml:space="preserve">Essieu avant</sys:String>
