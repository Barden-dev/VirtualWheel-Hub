    <sys:String x:Key="OutputTest_SteeringLeft" xml:space="preserve">Lenkung: nur links</sys:String>
    <sys:String x:Key="OutputTest_SteeringRight" xml:space="preserve">Lenkung: nur rechts</sys:String>
    <sys:String x:Key="OutputTest_Gas" xml:space="preserve">Gas: drücken und loslassen</sys:String>
    <sys:String x:Key="OutputTest_Brake" xml:space="preserve">Bremse: drücken und loslassen</sys:String>
    <sys:String x:Key="OutputTest_Nav" xml:space="preserve">Im Spiel zuweisen</sys:String>
    <sys:String x:Key="OutputTest_Unavailable" xml:space="preserve">Die Testausgabe ist im Vorschaumodus nicht verfügbar.</sys:String>
    <sys:String x:Key="OutputTest_ShiftDown" xml:space="preserve">Schalten Sie nach unten</sys:String>
    <sys:String x:Key="OutputTest_ShiftUp" xml:space="preserve">Hochschalten</sys:String>
    <sys:String x:Key="OutputTest_Mode" xml:space="preserve">Modus</sys:String>
    <sys:String x:Key="OutputTest_Once" xml:space="preserve">Einmal</sys:String>
    <sys:String x:Key="OutputTest_Repeat" xml:space="preserve">Wiederholen, bis es aufhört</sys:String>
    <sys:String x:Key="OutputTest_OnceHint" xml:space="preserve">Einmal: ein kurzes Drücken des Gangs oder ein Schwenken der Achse, um in die Neutralstellung zurückzukehren. Der Test stoppt dann automatisch.</sys:String>
    <sys:String x:Key="OutputTest_RepeatHint" xml:space="preserve">Wiederholen: Das ausgewählte Signal wird wiederholt, bis Sie den Test stoppen.</sys:String>
    <sys:String x:Key="OutputTest_Sound" xml:space="preserve">Countdown, Start- und Endgeräusche</sys:String>
    <sys:String x:Key="OutputTest_Sending" xml:space="preserve">Eine Aktion ausführen · Entkommen, um anzuhalten</sys:String>
    <sys:String x:Key="InputDevices_Title" xml:space="preserve">Eingabegeräte</sys:String>
    <sys:String x:Key="InputDevices_StopHint" xml:space="preserve">Suchen, Testen oder Speichern stoppt den Hub. Das gespeicherte Paar wird von allen Profilen gemeinsam genutzt.</sys:String>
    <sys:String x:Key="InputDevices_Refresh" xml:space="preserve">Liste aktualisieren</sys:String>
    <sys:String x:Key="InputDevices_Check" xml:space="preserve">Testen Sie ausgewählte Geräte</sys:String>
    <sys:String x:Key="InputDevices_StopCheck" xml:space="preserve">Test beenden</sys:String>
    <sys:String x:Key="InputDevices_Mouse" xml:space="preserve">Maus</sys:String>
    <sys:String x:Key="InputDevices_Keyboard" xml:space="preserve">Tastatur</sys:String>
    <sys:String x:Key="InputDevices_Select" xml:space="preserve">Wählen Sie ein Gerät aus</sys:String>
    <sys:String x:Key="InputDevices_FindMouse" xml:space="preserve">Identifizieren Sie sich durch Bewegung</sys:String>
    <sys:String x:Key="InputDevices_FindKeyboard" xml:space="preserve">Identifizieren per Tastendruck</sys:String>
    <sys:String x:Key="InputDevices_Choose" xml:space="preserve">Wählen Sie Ihre Geräte.</sys:String>
    <sys:String x:Key="InputDevices_None" xml:space="preserve">Eine Maus oder Tastatur wurde nicht gefunden. Schließen Sie die Geräte an und aktualisieren Sie sie. Wenn der Zugriff verweigert wird, öffnen Sie die Gerätediagnose, um Eingabeberechtigungen vorzubereiten.</sys:String>
    <sys:String x:Key="InputDevices_Missing" xml:space="preserve">Ein zuvor ausgewähltes Gerät ist nicht verfügbar. Wählen Sie den Ersatz explizit aus.</sys:String>
    <sys:String x:Key="InputDevices_Error" xml:space="preserve">Die ausgewählten Geräte konnten nicht geöffnet oder gespeichert werden. Aktualisieren Sie die Liste und überprüfen Sie den Gerätezugriff in der Diagnose. Einzelheiten finden Sie im Hub-Protokoll.</sys:String>
    <sys:String x:Key="InputDevices_Checking" xml:space="preserve">Bewegen Sie die ausgewählte Maus oder drücken Sie die Tasten, um die Aktivität zu überprüfen. Die Kontrollen bleiben eingestellt.</sys:String>
    <sys:String x:Key="InputDevices_MoveMouse" xml:space="preserve">Bewegen Sie die Maus, die Sie auswählen möchten, innerhalb von 10 Sekunden.</sys:String>
    <sys:String x:Key="InputDevices_PressKey" xml:space="preserve">Drücken Sie innerhalb von 10 Sekunden eine Taste auf der Tastatur, die Sie auswählen möchten.</sys:String>
    <sys:String x:Key="InputDevices_Found" xml:space="preserve">Gerät ausgewählt. Die Suche wurde gestoppt.</sys:String>
    <sys:String x:Key="InputDevices_Timeout" xml:space="preserve">Keine Aktivität erkannt. Versuchen Sie es erneut oder wählen Sie ein Gerät aus der Liste aus.</sys:String>
    <sys:String x:Key="InputDevices_Saved" xml:space="preserve">Auswahl für alle Profile gespeichert. Starten Sie die Hub-Steuerung, wenn Sie bereit sind.</sys:String>
    <sys:String x:Key="InputDevices_Unavailable" xml:space="preserve">Gerät nicht verfügbar oder nicht ausgewählt.</sys:String>
    <sys:String x:Key="InputDevices_Activity" xml:space="preserve">Eingabe erkannt</sys:String>
    <sys:String x:Key="InputDevices_Idle" xml:space="preserve">Verbunden – wartet auf Eingabe</sys:String>
    <sys:String x:Key="Tour_Open" xml:space="preserve">Erste Schritte</sys:String>
    <sys:String x:Key="Tour_Example" xml:space="preserve">ILLUSTRATION – nicht Ihr aktueller Spielstatus</sys:String>
    <sys:String x:Key="Tour_Progress" xml:space="preserve">SCHRITT {0} VON {1}</sys:String>
    <sys:String x:Key="Tour_Start" xml:space="preserve">Nehmen Sie an der Tour teil</sys:String>
    <sys:String x:Key="Tour_Next" xml:space="preserve">Als nächstes</sys:String>
    <sys:String x:Key="Tour_Back" xml:space="preserve">Zurück</sys:String>
    <sys:String x:Key="Tour_Finish" xml:space="preserve">Fertig</sys:String>
    <sys:String x:Key="Tour_Skip" xml:space="preserve">Exit-Tour</sys:String>
    <sys:String x:Key="Tour_Later" xml:space="preserve">Überspringen Sie es vorerst</sys:String>
    <sys:String x:Key="Tour_WelcomeTitle" xml:space="preserve">Willkommen bei vWheel Hub</sys:String>
    <sys:String x:Key="Tour_WelcomePath" xml:space="preserve">Ihre Maus und Tastatur → ein virtueller Renncontroller</sys:String>
    <sys:String x:Key="Tour_WelcomeBody" xml:space="preserve">Vielen Dank fürs Herunterladen! Wählen Sie zuerst Ihre Sprache. Diese kurze Tour zeigt, wo Sie Geräte auswählen, Steuerungen zuweisen und an einem Rennen teilnehmen können. Wir werden echte Seiten hervorheben und häufige Stolpersteine ​​erklären.</sys:String>
    <sys:String x:Key="Tour_WelcomeTip" xml:space="preserve">Ungefähr 4 Minuten. Während der Tour bleibt die Nabe stehen; Es werden keine Spieleinstellungen oder Bindungen geändert. Sie können dieses Handbuch über „Erste Schritte“ in der Seitenleiste erneut öffnen. Die installierten Sprachen sind oben aufgeführt; fehlende Übersetzungen verwenden Englisch.</sys:String>
    <sys:String x:Key="Tour_ProfilesTitle" xml:space="preserve">Beginnen Sie mit einem Profil</sys:String>
    <sys:String x:Key="Tour_ProfilesPath" xml:space="preserve">Profile → Spiel → Profil</sys:String>
    <sys:String x:Key="Tour_ProfilesBody" xml:space="preserve">Ein Profil speichert Ihre Lenk-, Pedal- und Tasteneinstellungen. Wählen Sie hier das Spiel und ein Profil. Universal ist ein nützlicher Ausgangspunkt für ein Spiel ohne dedizierte Integration. Sie können separate Profile für verschiedene Autos oder Fahrstile erstellen.</sys:String>
    <sys:String x:Key="Tour_ProfilesTip" xml:space="preserve">Überprüfen Sie den Profilnamen über den Steuerelementen, bevor Sie ihn bearbeiten. Die Spielerkennung kann auf einen anderen Kontext hinweisen; Überprüfen Sie die Eingabeaufforderung zum Wechseln, wenn Sie nicht gespeicherte Änderungen haben.</sys:String>
    <sys:String x:Key="Tour_OutputTitle" xml:space="preserve">Was das Spiel erhält</sys:String>
    <sys:String x:Key="Tour_OutputPath" xml:space="preserve">Steuerelemente → Ausgabegeräte</sys:String>
    <sys:String x:Key="Tour_OutputBody" xml:space="preserve">Ändern Sie hier Achsenbereiche und -richtung. Geräteprüfungen und Reparaturen sind im Dashboard verfügbar.</sys:String>
    <sys:String x:Key="Tour_OutputWindows" xml:space="preserve">Windows verwendet vJoy. Wenn eine Einrichtung erforderlich ist, zeigt das Dashboard das Problem an und öffnet die Gerätereparatur. Konfigurationsänderungen erfordern eine Bestätigung.</sys:String>
    <sys:String x:Key="Tour_OutputLinux" xml:space="preserve">Linux: Verwenden Sie die native Ausgabe uinput und gewähren Sie den angeforderten Eingabe-/uinput-Zugriff. Starten Sie den Hub vor dem Spiel. Deaktivieren Sie für LMU bis Steam/Proton den Steam-Eingang für das Spiel, damit es das virtuelle Rad direkt sehen kann.</sys:String>
    <sys:String x:Key="Tour_InputTitle" xml:space="preserve">Welche Geräte Sie verwenden</sys:String>
    <sys:String x:Key="Tour_InputPath" xml:space="preserve">Steuerelemente → Eingabegeräte</sys:String>
    <sys:String x:Key="Tour_InputBody" xml:space="preserve">Wählen Sie Ihre Maus und Tastatur in ihren Karten aus oder identifizieren Sie sie durch Bewegung und Tastendruck. Wenn ein Gerät gefunden wird, wird die Suche automatisch beendet. Verwenden Sie „Speichern“ im Profilkopf, um das Paar zusammen mit Ihren anderen Änderungen zu speichern. In der Kopfzeile wird angezeigt, wenn Änderungen nicht gespeichert werden.</sys:String>
    <sys:String x:Key="Tour_InputTip" xml:space="preserve">Beim Testen ausgewählter Geräte wird nur die Aktivität angezeigt. Durch das Stoppen eines Tests bleibt der Entwurf erhalten. Durch Rückgängigmachen in der Kopfzeile wird auch die nicht gespeicherte Geräteauswahl rückgängig gemacht. Die gespeicherte Maus und Tastatur bleiben von allen Profilen gemeinsam genutzt.</sys:String>
    <sys:String x:Key="Tour_KeysTitle" xml:space="preserve">Was jeder Schlüssel bewirkt</sys:String>
    <sys:String x:Key="Tour_KeysPath" xml:space="preserve">Steuerelemente → Tastenkombinationen</sys:String>
    <sys:String x:Key="Tour_KeysBody" xml:space="preserve">Weisen Sie hier Gas, Bremse, Gänge, Nabenbefehle und virtuelle Spieltasten zu. Klicken Sie auf ein Tastenfeld und drücken Sie die Taste oder Maustaste, die Sie verwenden möchten.</sys:String>
    <sys:String x:Key="Tour_KeysTip" xml:space="preserve">Es gibt zwei Ebenen: Weisen Sie Ihre physischen Tasten im Hub zu und weisen Sie dann die virtuellen Achsen/Tasten des Hubs im Spiel zu. Die nächsten Schritte erklären die zweite Ebene.</sys:String>
    <sys:String x:Key="Tour_AssignmentTitle" xml:space="preserve">Weisen Sie Steuerelemente im Spiel zu</sys:String>
    <sys:String x:Key="Tour_AssignmentPath" xml:space="preserve">Steuerung → Bindung im Spiel</sys:String>
    <sys:String x:Key="Tour_AssignmentBody" xml:space="preserve">Wählen Sie Lenkung, Gas, Bremse oder Gangschaltung. Verwenden Sie „Einmal“ für eine einzelne Zuweisung, damit durch wiederholtes Drücken die Menüs anschließend nicht gewechselt werden können. Klicken Sie auf Start, wechseln Sie zum Spiel und öffnen Sie die gewünschte Bindung: Nach 5 Sekunden beginnt das Signal.</sys:String>
    <sys:String x:Key="Tour_AssignmentTip" xml:space="preserve">Wiederholen Sie die Läufe, bis sie gestoppt werden. Escape oder Stop beendet das Signal. Akustische Hinweise helfen Ihnen, den Countdown zu verfolgen. Die Auswahl physischer Geräte auf Eingabegeräten ist ein separater Schritt. Sie müssen den Namen der zugrunde liegenden Gamepad-Taste nicht kennen.</sys:String>
    <sys:String x:Key="Tour_AxesTitle" xml:space="preserve">Lenkung und Pedale einstellen</sys:String>
    <sys:String x:Key="Tour_AxesPath" xml:space="preserve">Steuerung → Achsensteuerung → Lenkung / Gas / Bremse</sys:String>
    <sys:String x:Key="Tour_AxesBody" xml:space="preserve">Beginnen Sie mit den Standardeinstellungen und passen Sie dann jeweils eine Einstellung an. Lenkung steuert, wie Mausbewegungen oder Lenktasten das Rad drehen. Gas und Bremse steuern, wie schnell virtuelle Pedale gedrückt und losgelassen werden. Beobachten Sie den Ausgabemonitor während des Tests bei laufendem Hub und überprüfen Sie dann das Ergebnis auf der Strecke.</sys:String>
    <sys:String x:Key="Tour_AxesTip" xml:space="preserve">Verwenden Sie das Zuweisungstool, wenn Sie ein bekanntes Ausgangssignal benötigen. Bei dieser Tour wird niemals ein Signal ausgelöst oder die Bindung geändert.</sys:String>
    <sys:String x:Key="Tour_ReadyTitle" xml:space="preserve">Speichern, starten, fahren</sys:String>
    <sys:String x:Key="Tour_ReadyPath" xml:space="preserve">Dashboard → Hub starten</sys:String>
    <sys:String x:Key="Tour_ReadyBody" xml:space="preserve">Speichern Sie Ihr Profil, bevor Sie gehen. Starten Sie den Hub, starten Sie dann das Spiel und nehmen Sie an einem Rennen teil. Aktivieren Sie „Maus sperren“, wenn Sie steuern möchten, ohne dass der Zeiger das Spiel verlässt. Deaktivieren Sie es, um den Desktop wieder zu verwenden. Sie können Tastenkombinationen für die Hub- und Maussperre zuweisen.</sys:String>
    <sys:String x:Key="Tour_ReadyTip" xml:space="preserve">Wenn etwas nicht reagiert: Überprüfen Sie die physische Geräteaktivität → Hub-Anbindungen → virtuelle Ausgabe → Spielanbindungen. Öffnen Sie dieses Handbuch jederzeit erneut unter „Erste Schritte“. Wenn Sie fertig sind, kehren Sie zur vorherigen Seite zurück.</sys:String>
    <sys:String x:Key="Tour_ShowPage" xml:space="preserve">Seite anzeigen</sys:String>
    <sys:String x:Key="Tour_ShowExplanation" xml:space="preserve">Erklärung anzeigen</sys:String>
    <sys:String x:Key="Tour_DashboardTitle" xml:space="preserve">Ihr Ausgangspunkt</sys:String>
    <sys:String x:Key="Tour_DashboardPath" xml:space="preserve">Übersicht</sys:String>
    <sys:String x:Key="Tour_DashboardBody" xml:space="preserve">Dies ist die erste Seite, die Sie sehen. Es zeigt das aktuelle Spiel, den Hub-Status und die Gerätediagnose. Starten oder stoppen Sie die Steuerung mit dem Hubschalter oben. Der Ausgabemonitor unten zeigt Lenkung, Gas und Bremse. Ein angeschlossener Controller und ein angeschlossenes Spiel sind getrennte Dinge.</sys:String>
    <sys:String x:Key="Tour_DashboardTip" xml:space="preserve">Wir folgen der angezeigten Reihenfolge der Seitenleiste und der Registerkarten „Steuerelemente“. Der Hub bleibt während der gesamten Tour angehalten.</sys:String>
    <sys:String x:Key="Tour_SettingsTitle" xml:space="preserve">Anwendungspräferenzen</sys:String>
    <sys:String x:Key="Tour_SettingsPath" xml:space="preserve">Einstellungen → Allgemein</sys:String>
    <sys:String x:Key="Tour_SettingsBody" xml:space="preserve">Hier konfigurieren Sie, wie die Anwendung startet und sich auf dem Desktop verhält: automatischer Hub-Start, Minimierung, Sounds in der Taskleiste und bei Maussperre. Die Sprache kann auch über die Auswahl in der Titelleiste geändert werden. Legen Sie diese Einstellungen fest, nachdem Ihr erstes Arbeitsprofil fertig ist.</sys:String>
    <sys:String x:Key="Tour_SettingsTip" xml:space="preserve">Mit der Schaltfläche „Erste Schritte“ in der Seitenleiste können Sie diese Tour bei Bedarf erneut öffnen. Das Überspringen oder Beenden der Tour speichert, dass sie angezeigt wurde.</sys:String>
    <sys:String x:Key="InputDevices_CancelFind" xml:space="preserve">Suche abbrechen</sys:String>
    <sys:String x:Key="InputDevices_Unsaved" xml:space="preserve">Auswahl nicht gespeichert – verwenden Sie oben „Speichern“.</sys:String>
    <sys:String x:Key="InputDevices_SavedShort" xml:space="preserve">Gespeichert</sys:String>
    <sys:String x:Key="Ui_ChangesSaveError" xml:space="preserve">Es konnten nicht alle Änderungen gespeichert werden. Ihre ausstehenden Änderungen bleiben erhalten. Überprüfen Sie den Status des Eingabegeräts oder das Protokoll.</sys:String>
    <sys:String x:Key="InputDevices_FindPair" xml:space="preserve">Identifizieren Sie Maus und Tastatur</sys:String>
    <sys:String x:Key="InputDevices_PairMouse" xml:space="preserve">Bewegen Sie die Maus, die Sie verwenden möchten.</sys:String>
    <sys:String x:Key="InputDevices_PairKeyboard" xml:space="preserve">Drücken Sie nun eine Taste auf der Tastatur, die Sie verwenden möchten.</sys:String>
    <sys:String x:Key="InputDevices_PairFound" xml:space="preserve">Beide Geräte ausgewählt. Verwenden Sie oben „Speichern“, um sie anzuwenden.</sys:String>
    <sys:String x:Key="Output_WheelPrepare" xml:space="preserve">Virtuelles Rad einrichten...</sys:String>
    <sys:String x:Key="Output_WheelPrepareHint" xml:space="preserve">Überprüft das ausgewählte vJoy-Gerät oder erstellt es, wenn diese Nummer nicht konfiguriert ist. Vorhandene Konfigurationen bleiben erhalten. Datenausgang und Steuerungsbindungen im Spiel werden separat eingerichtet.</sys:String>
    <sys:String x:Key="Output_WheelConfirm" xml:space="preserve">vJoy Gerät {0} auf Radkompatibilität prüfen? Wenn die Anzahl nicht konfiguriert ist, erstellen Sie sie mit 8 Achsen, 128 Schaltflächen, einem diskreten POV und allen FFB-Effekten. Vorhandene Geräte werden nicht überschrieben. Schließen Sie Spiele und andere Feeder-Programme: Beim Erstellen eines Geräts wird der Treiber möglicherweise neu gestartet. Möglicherweise ist eine Administratorberechtigung erforderlich. Datenausgang und In-Game-Bindungen werden separat konfiguriert.</sys:String>
    <sys:String x:Key="Output_WheelIncomplete" xml:space="preserve">Das vJoy-Gerät {0} benötigt die Rad-POV-/FFB-Konfiguration.</sys:String>
    <sys:String x:Key="Output_WheelStopFirst" xml:space="preserve">Stoppen Sie die Nabensteuerung, bevor Sie das Rad vorbereiten.</sys:String>
    <sys:String x:Key="Output_WheelReady" xml:space="preserve">Radkonfiguration überprüft. Speichern Sie das Profil, starten Sie die Hub-Steuerung und wählen Sie dann Ihre individuelle Radkonfiguration im Spiel aus.</sys:String>
    <sys:String x:Key="Output_WheelFailed" xml:space="preserve">Radvorbereitung fehlgeschlagen. Überprüfen Sie den Treiber und ob ein anderer Feeder das ausgewählte Gerät verwendet.</sys:String>
    <sys:String x:Key="Output_VJoyExistingProtected" xml:space="preserve">vJoy-Gerät {0} existiert bereits. FREE bedeutet nur, dass es derzeit nicht verwendet wird. Der Hub behält seine Konfiguration bei. Verwenden Sie ein kompatibles vorhandenes Gerät ohne Änderungen oder wählen Sie eine nicht konfigurierte Nummer. Die automatische Ersetzung ist erst verfügbar, wenn Sicherung und Wiederherstellung implementiert sind.</sys:String>
    <sys:String x:Key="Output_VJoyConfigurationUnknown" xml:space="preserve">Die gespeicherte Konfiguration des vJoy-Geräts {0} kann nicht sicher überprüft werden. Überprüfen Sie, ob der Treiber verfügbar ist, und versuchen Sie erneut, das Gerät zu überprüfen.</sys:String>
    <sys:String x:Key="Output_VJoyBackup" xml:space="preserve">Sichern Sie die vJoy-Konfiguration</sys:String>
    <sys:String x:Key="Output_VJoyBackupSaved" xml:space="preserve">Verifizierter Sicherungs- und Vorgangsdatensatz gespeichert: {0}</sys:String>
    <sys:String x:Key="Output_VJoyBackupFailed" xml:space="preserve">Der überprüfte Sicherungs- oder Vorgangsdatensatz vJoy konnte nicht abgeschlossen werden. Ohne eine verifizierte Sicherung kann das Setup nicht fortgesetzt werden.</sys:String>
    <sys:String x:Key="Output_VJoyInspect" xml:space="preserve">Überprüfen Sie alle vJoy-Geräte</sys:String>
    <sys:String x:Key="Output_VJoyUseExisting" xml:space="preserve">Bestehendes ohne Änderungen nutzen</sys:String>
    <sys:String x:Key="Output_VJoyCheck" xml:space="preserve">Gerät prüfen</sys:String>
    <sys:String x:Key="Output_VJoySharedSelected" xml:space="preserve">Gemeinsame Hub-Ausgabe: vJoy #{0}. Diese Zahl bleibt über Spiele und Neustarts hinweg erhalten.</sys:String>
    <sys:String x:Key="Output_VJoyNotSelected" xml:space="preserve">Das virtuelle Rad muss eingerichtet werden. Öffnen Sie die Gerätediagnose im Dashboard.</sys:String>
    <sys:String x:Key="Output_VJoySelectionIssue" xml:space="preserve">Die freigegebene vJoy-Ausgabe erfordert Aufmerksamkeit. Es wird kein Gerät automatisch ersetzt oder stattdessen ausgewählt.</sys:String>
    <sys:String x:Key="Output_VJoyExisting" xml:space="preserve">vorhanden</sys:String>
    <sys:String x:Key="Output_VJoyBusy" xml:space="preserve">Wird von einem anderen Feeder verwendet</sys:String>
    <sys:String x:Key="Output_VJoyUnconfigured" xml:space="preserve">Nummer nicht konfiguriert</sys:String>
    <sys:String x:Key="Output_VJoyPersisted" xml:space="preserve">gespeicherte Konfiguration; Gerät nicht verfügbar</sys:String>
    <sys:String x:Key="Output_VJoyUnknown" xml:space="preserve">kann nicht verifizieren</sys:String>
    <sys:String x:Key="Output_VJoyInventoryRow" xml:space="preserve">#{0}: {1}; Achsen {2}, Tasten {3}, diskreter POV {4}, kontinuierlicher POV {5}</sys:String>
    <sys:String x:Key="Output_VJoySelectCompatible" xml:space="preserve">Wählen Sie ein barrierefreies vorhandenes Gerät mit den erforderlichen Funktionen. Ein belegtes oder inkompatibles Gerät wird nicht neu konfiguriert.</sys:String>
    <sys:String x:Key="Output_VJoyAdoptConfirm" xml:space="preserve">vJoy #{0} als Shared Hub-Ausgabe verwenden, ohne die Konfiguration zu ändern? Dieses Profil wechselt von seinem individuellen Gerät #{1} zur freigegebenen Ausgabe, nachdem Sie es gespeichert haben. Andere gespeicherte Profile behalten ihre bestehende Geräteauswahl. Das Ändern der Ausgabenummer erfordert möglicherweise eine Neuzuordnung der Steuerelemente im Spiel. Durch die Auswahl eines Geräts wird keine Berechtigung zum Entfernen erteilt.</sys:String>
    <sys:String x:Key="Output_VJoyAdopted" xml:space="preserve">vJoy #{0} ausgewählt. Vorhandene Geräteeinstellungen bleiben unverändert. Weise das Gerät bei Bedarf im Spiel zu.</sys:String>
    <sys:String x:Key="Output_VJoyNoUnusedNumbers" xml:space="preserve">Kein geeignetes freies Gerät und keine bestätigt unbenutzte vJoy-Nummer gefunden. Vorhandene Konfigurationen bleiben unverändert.</sys:String>
    <sys:String x:Key="Output_VJoyCreate" xml:space="preserve">Erstellen Sie ein dediziertes Hub-Gerät</sys:String>
    <sys:String x:Key="Output_VJoyCreateConfirm" xml:space="preserve">vJoy #{0} für den Hub erstellen? Vorhandene oder ungeprüfte Geräte ({1}) werden nicht geändert. Das neue Gerät erhält 8 Achsen, 128 Tasten, POV und FFB. Schließe Spiele und andere Controllerprogramme. Zuerst wird eine Sicherung erstellt. Windows kann Administratorrechte und einen Neustart verlangen. Weise das neue Gerät bei Bedarf im Spiel zu.</sys:String>
