    <sys:String x:Key="Prep_NextDevice" xml:space="preserve">Überspringen Sie dieses Gerät</sys:String>
    <sys:String x:Key="Common_Select" xml:space="preserve">Auswählen</sys:String>
    <sys:String x:Key="OutputTest_Title" xml:space="preserve">Steuerung testen und zuweisen</sys:String>
    <sys:String x:Key="OutputTest_Hint" xml:space="preserve">Wählen Sie eine Aktion und einen Modus. Nach dem Start haben Sie 5 Sekunden Zeit, um zum Spiel zu wechseln. Die Achsen bewegen sich mit 0,5-Sekunden-Übergängen über ihren gesamten Bereich. Während des Tests werden die normalen Nabensteuerungen ausgesetzt. Der berechnete Steuerausgangsmonitor zeigt das Testsignal nicht an und bestätigt den Geräteausgang nicht.</sys:String>
    <sys:String x:Key="OutputTest_StopHint" xml:space="preserve">Stopp: Entkommen Sie in einem beliebigen Fenster oder über die Schaltfläche „Stopp“. Geben Sie gebundene Schlüssel nach dem Test frei. Sie können die Cursorsperre manuell wieder aktivieren.</sys:String>
    <sys:String x:Key="OutputTest_Ready" xml:space="preserve">Bereit zum Start</sys:String>
    <sys:String x:Key="OutputTest_ContextChanged" xml:space="preserve">Der Test wurde abgebrochen, weil sich das Profil oder die Hub-Sitzung geändert hat. Überprüfen Sie das aktuelle Profil und starten Sie den Test erneut.</sys:String>
    <sys:String x:Key="OutputTest_Start" xml:space="preserve">Starten</sys:String>
    <sys:String x:Key="OutputTest_Stop" xml:space="preserve">Stoppen</sys:String>
    <sys:String x:Key="OutputTest_Running" xml:space="preserve">Signalwiederholung · Flucht zum Anhalten</sys:String>
    <sys:String x:Key="OutputTest_Countdown" xml:space="preserve">Ab {0} s… Wechseln Sie zum Spiel.</sys:String>
    <sys:String x:Key="OutputTest_Error" xml:space="preserve">Test gestoppt: {0}</sys:String>
