<ui:FluentWindow x:Class="SimRacingHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:pages="clr-namespace:SimRacingHub.Views.Pages"
        xmlns:local="clr-namespace:SimRacingHub.Controls"
        xmlns:core="clr-namespace:SimRacingHub.Core"
        xmlns:conv="clr-namespace:SimRacingHub.Converters"
        Title="vWheel Hub" Height="700" Width="1100" MinWidth="1100" MinHeight="600"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="HighQuality"
        Icon="pack://application:,,,/icon.ico"
        AllowDrop="True"
        PreviewDragEnter="MainWindow_PreviewDragEnter"
        PreviewDragOver="MainWindow_PreviewDragOver"
        PreviewDragLeave="MainWindow_PreviewDragLeave"
        PreviewDrop="MainWindow_PreviewDrop"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </ui:FluentWindow.Resources>

    <Grid AllowDrop="True">
        <!-- App TitleBar -->
        <ui:TitleBar Padding="10,0,0,0">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,-10,0,0">
                    <TextBlock Text="vWheel Hub" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="by Barden-dev" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,1,8,0" />
                    <Border x:Name="BuildBadgeBorder" Background="#27272A" BorderBrush="#52525B" BorderThickness="1" CornerRadius="4" Padding="6,1,6,2" VerticalAlignment="Center" ToolTip="OpenSource Free Build">
                        <TextBlock x:Name="BuildBadgeText" Text="FREE" FontSize="10" FontWeight="Bold" Foreground="#A1A1AA" />
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.TrailingContent>
                <TextBlock Text="{Binding CurrentVersion, StringFormat='v{0}'}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center" Margin="0,-10,12,0"/>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <Grid Margin="0,32,0,0" AllowDrop="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            
            <StackPanel Grid.Row="0" Margin="20,5,20,0">
                <!-- Update Available Notification Banner -->
                <Border x:Name="UpdateBanner" 
                        Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Background="#1E293B" 
                        BorderBrush="#3B82F6" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="12,8" 
                        Margin="0,0,0,5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon Grid.Column="0" Symbol="ArrowDownload24" Foreground="#60A5FA" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="#93C5FD">
                                <Run Text="New update available: v" /><Run Text="{Binding LatestVersion, Mode=OneWay}" /><Run Text=" (Current: v" /><Run Text="{Binding CurrentVersion, Mode=OneWay}" /><Run Text=")" />
                            </TextBlock>
                            <TextBlock FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                                <Run Text="A new version of vWheel Hub is available. Click to get the update." />
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <ui:Button Command="{Binding OpenUpdateUrlCommand}" 
                                       Appearance="Primary" 
                                       Padding="12,5" 
                                       FontSize="12" 
                                       Content="Update" 
                                       Margin="0,0,6,0"/>
                            <ui:Button Command="{Binding DismissUpdateBannerCommand}" 
                                       Appearance="Transparent" 
                                       Padding="4" 
                                       FontSize="12" 
                                       ToolTip="Dismiss">
                                <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" />
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- OpenSource Thin Persistent Status Bar (Option A) -->
                <Border x:Name="FreeVersionStatusBar" Visibility="Visible"
                        Background="#261523" 
                        BorderBrush="#4A1E3D" 
                        BorderThickness="1" 
                        CornerRadius="6" 
                        Padding="12,6,12,6" 
                        Margin="0,0,0,5">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                            <ui:SymbolIcon Symbol="Sparkle16" Foreground="#EC4899" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock FontSize="12" VerticalAlignment="Center">
                                <Run Text="Live Telemetry &amp; " FontWeight="SemiBold" Foreground="#F472B6" />
                                <Run Text="{Binding TotalProFeaturesCount, Mode=OneWay}" FontWeight="SemiBold" Foreground="#F472B6" />
                                <Run Text=" Pro features" FontWeight="SemiBold" Foreground="#F472B6" />
                                <Run Text=" are available in Pro version" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </TextBlock>
                        </StackPanel>

                        <ui:Button Command="{Binding OpenBoostyCommand}" 
                                   Appearance="Transparent" 
                                   Padding="6,2" 
                                   FontSize="12" 
                                   Foreground="#F472B6" 
                                   HorizontalAlignment="Right" 
                                   VerticalAlignment="Center"
                                   ToolTip="View Pro Features on Boosty">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Unlock Pro" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <ui:SymbolIcon Symbol="ArrowRight16" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                        </ui:Button>
                    </Grid>
                </Border>

                <ui:InfoBar Title="Status"
                            Message="{Binding LastStatusMessage, Source={x:Static core:AppLogger.Instance}}"
                            IsOpen="{Binding LastStatusMessage, Source={x:Static core:AppLogger.Instance}, Converter={StaticResource NullToVisibilityConverter}}"
                            Severity="Informational" IsClosable="True" Margin="0,0,0,5" />

                <ui:InfoBar Title="Auto-Detected Context"
                            Message="A new game was detected, but you have unsaved changes in your active profile."
                            IsOpen="{Binding PendingContext, Converter={StaticResource NullToVisibilityConverter}}"
                            Severity="Warning" IsClosable="False">
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                        <ui:Button Content="Save &amp; Switch" Command="{Binding SaveAndSwitchToPendingContextCommand}" Appearance="Primary" Margin="0,0,8,0" />
                        <ui:Button Content="Switch &amp; Discard" Command="{Binding SwitchToPendingContextCommand}" Appearance="Secondary" Margin="0,0,8,0" />
                        <ui:Button Content="Keep Current" Command="{Binding IgnorePendingContextCommand}" Appearance="Secondary" />
                    </StackPanel>
                </ui:InfoBar>
            </StackPanel>

            <ui:NavigationView Grid.Row="1" x:Name="RootNavigation"
                               AllowDrop="True"
                               PaneTitle="vWheel Hub"
                               PaneDisplayMode="Left"
                               IsPaneToggleVisible="False"
                               IsPaneOpen="True"
                               OpenPaneLength="180"
                               ScrollViewer.VerticalScrollBarVisibility="Visible"
                               IsBackButtonVisible="Collapsed"
                               local:FadingEdgeBehavior.IsEnabled="True">
                <ui:NavigationView.MenuItems>
                    <ui:NavigationViewItem Content="Overview" TargetPageType="{x:Type pages:DashboardPage}" Icon="{ui:SymbolIcon Home24}" />
                    <ui:NavigationViewItem Content="Steering" TargetPageType="{x:Type pages:SteeringPage}" Icon="{ui:SymbolIcon ArrowClockwise24}" />
                    <ui:NavigationViewItem Content="Throttle Logic" TargetPageType="{x:Type pages:GasLogicPage}" Icon="{ui:SymbolIcon Flash24}" />
                    <ui:NavigationViewItem Content="Brake Logic" TargetPageType="{x:Type pages:BrakeLogicPage}" Icon="{ui:SymbolIcon Stop24}" />
                    <ui:NavigationViewItem Content="Trail Braking" TargetPageType="{x:Type pages:TrailBrakingPage}" Icon="{ui:SymbolIcon ArrowTrendingDown24}" />
                    <ui:NavigationViewItem Content="Audio Feedback" TargetPageType="{x:Type pages:SlipAudioPage}" Icon="{ui:SymbolIcon Speaker224}" />
                    
                    <ui:NavigationViewItemSeparator />
                    <ui:NavigationViewItem Content="vJoy Axes" TargetPageType="{x:Type pages:VjoyAxesPage}" Icon="{ui:SymbolIcon XboxController24}" />
                    <ui:NavigationViewItem Content="Key Bindings" TargetPageType="{x:Type pages:KeyBindingsPage}" Icon="{ui:SymbolIcon Keyboard24}" />
                </ui:NavigationView.MenuItems>

                <ui:NavigationView.FooterMenuItems>
                    <ui:NavigationViewItemHeader Text="COMMUNITY" Margin="12,2,0,2" />
                    <ui:NavigationViewItem Content="Boosty" Command="{Binding OpenBoostyCommand}" Icon="{ui:SymbolIcon Heart24}" ToolTip="Support the project on Boosty!" />
                    <ui:NavigationViewItem Content="Discord" Command="{Binding OpenDiscordCommand}" Icon="{ui:SymbolIcon Chat24}" ToolTip="Join our Discord community for support and updates." />
                    <ui:NavigationViewItem Content="GitHub" Command="{Binding OpenGithubCommand}" Icon="{ui:SymbolIcon Code24}" ToolTip="View open-source repository on GitHub." />
                    <ui:NavigationViewItem Content="Wiki" Command="{Binding OpenWikiCommand}" Icon="{ui:SymbolIcon Book24}" ToolTip="View documentation and guides on Wiki." />
                </ui:NavigationView.FooterMenuItems>

                <!-- Content Header: 2-Tier Structured Top Bar -->
                <ui:NavigationView.Header>
                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" Margin="20,0,20,0" Padding="0,4,0,8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Row 0: Context Path & Status on Left, Master Hub Toggles on Right -->
                            <Grid Grid.Row="0" Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Left: Profile Breadcrumb and Status Pill -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Folder24" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBlock Text="{Binding CurrentContext.DisplayPath, FallbackValue='Universal'}" 
                                               FontSize="15.5" FontWeight="SemiBold" 
                                               VerticalAlignment="Center" 
                                               TextTrimming="CharacterEllipsis" 
                                               MaxWidth="420"
                                               ToolTip="{Binding CurrentContext.DisplayPath, FallbackValue='Universal'}"/>

                                    <!-- Status Pill Badge (Saved / Unsaved Changes / New Profile) -->
                                    <Border CornerRadius="4" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#1E293B"/>
                                                <Setter Property="BorderBrush" Value="#334155"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                                        <Setter Property="Background" Value="#38210A"/>
                                                        <Setter Property="BorderBrush" Value="#B45309"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsNewProfile}" Value="True">
                                                        <Setter Property="Background" Value="#142B1A"/>
                                                        <Setter Property="BorderBrush" Value="#15803D"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:SymbolIcon Margin="0,0,4,0" FontSize="12">
                                                <ui:SymbolIcon.Style>
                                                    <Style TargetType="ui:SymbolIcon">
                                                        <Setter Property="Symbol" Value="Save24" />
                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                                                <Setter Property="Symbol" Value="Warning24" />
                                                                <Setter Property="Foreground" Value="#F59E0B" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsNewProfile}" Value="True">
                                                                <Setter Property="Symbol" Value="Add24" />
                                                                <Setter Property="Foreground" Value="#4ADE80" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ui:SymbolIcon.Style>
                                            </ui:SymbolIcon>
                                            <TextBlock FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                        <Setter Property="Text" Value="Saved" />
                                                        <Setter Property="Foreground" Value="#94A3B8" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                                                <Setter Property="Text" Value="Unsaved Changes" />
                                                                <Setter Property="Foreground" Value="#F59E0B" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsNewProfile}" Value="True">
                                                                <Setter Property="Text" Value="New Profile" />
                                                                <Setter Property="Foreground" Value="#4ADE80" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Right: Master Hub Controls -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:ToggleSwitch IsChecked="{Binding LockMouse}" Content="Lock Mouse" ToolTip="Locks and centers the mouse cursor inside the screen while driving." Margin="0,0,14,0" VerticalAlignment="Center" />
                                    <Border CornerRadius="6" Padding="8,3" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                                        <ui:ToggleSwitch IsChecked="{Binding IsActive}" Content="HUB ACTIVE" FontWeight="Bold" ToolTip="Toggles mouse/keyboard input interception and vJoy axis output." VerticalAlignment="Center" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Row 1: Profile Toolbar Actions (Save, Undo, Share, Import) -->
                            <Grid Grid.Row="1" Margin="0,0,0,2">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:Button Command="{Binding SaveProfileCommand}" Appearance="Primary" Padding="12,5" Margin="0,0,6,0" FontSize="12" ToolTip="Saves the current profile to disk.">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Content" Value="Save Profile" />
                                                <Setter Property="Icon" Value="{ui:SymbolIcon Save24}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsNewProfile}" Value="True">
                                                        <Setter Property="Content" Value="Create Profile" />
                                                        <Setter Property="Icon" Value="{ui:SymbolIcon Add24}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>

                                    <ui:Button Content="Undo" Command="{Binding RevertProfileCommand}" Padding="10,5" Margin="0,0,6,0" FontSize="12">
                                        <ui:Button.Style>
                                            <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                                <Setter Property="Icon" Value="{ui:SymbolIcon ArrowUndo24}"/>
                                                <Setter Property="Appearance" Value="Secondary"/>
                                                <Setter Property="Opacity" Value="0.4"/>
                                                <Setter Property="ToolTip" Value="No changes to undo."/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CanUndo}" Value="True">
                                                        <Setter Property="Appearance" Value="Caution"/>
                                                        <Setter Property="Opacity" Value="1.0"/>
                                                        <Setter Property="ToolTip" Value="Click to undo your last unsaved profile change."/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ui:Button.Style>
                                    </ui:Button>

                                    <ui:Button Command="{Binding OpenProfilesFolderCommand}" Icon="{ui:SymbolIcon Folder24}" Content="Folder" Appearance="Secondary" Padding="10,5" Margin="0,0,6,0" FontSize="12" ToolTip="Opens your Profiles directory in Windows Explorer (Documents\vWheel Hub\Profiles)" />
                                    <ui:Button Command="{Binding OpenExportDialogCommand}" Icon="{ui:SymbolIcon Share24}" Content="Share" Appearance="Secondary" Padding="10,5" Margin="0,0,6,0" FontSize="12" ToolTip="Export or generate a Share Code for this profile" />
                                    <ui:Button Command="{Binding OpenImportDialogCommand}" Icon="{ui:SymbolIcon ArrowDownload24}" Content="Import" Appearance="Secondary" Padding="10,5" FontSize="12" ToolTip="Import a preset from Share Code, file or drag &amp; drop" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>
                </ui:NavigationView.Header>
            </ui:NavigationView>
                
            <!-- Footer output monitor pinned to bottom -->
            <Grid Grid.Row="2" Background="{DynamicResource ApplicationBackgroundBrush}">
                <Expander ExpandDirection="Up" IsExpanded="{Binding IsOutputMonitorExpanded, Mode=TwoWay}" Margin="20,0,20,10" Background="{DynamicResource ControlFillColorDefaultBrush}">
                    <Expander.Header>
                        <TextBlock Text="Output Monitor" FontWeight="SemiBold" />
                    </Expander.Header>
                    <Border Padding="15">
                        <StackPanel>
                            <TextBlock Text="Hover over the colored markers to view details, or drag them to quickly adjust your settings." 
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Steer" VerticalAlignment="Center" />
                                <local:MonitorBar Grid.Row="0" Grid.Column="1" Minimum="-32768" Maximum="32768" Value="{Binding SteerValue}" Height="10" Margin="0,0,0,5" Foreground="Gray"
                                                  AbsLimit1="{Binding ResolvedProfile.OutSteerMin}" AbsLimit1Name="VJoy Steer Min"
                                                  AbsLimit2="{Binding ResolvedProfile.OutSteerMax}" AbsLimit2Name="VJoy Steer Max"
                                                  SymLock="{Binding ResolvedProfile.CarSteeringLock}" SymLockName="Car Steering Lock" 
                                                  SymRange="{Binding ResolvedProfile.GlobalSteeringRange}"
                                                  IsSymLockEnabled="{Binding ResolvedProfile.UseSteeringLockClamp}"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Gas" VerticalAlignment="Center" />
                                <local:MonitorBar Grid.Row="1" Grid.Column="1" Minimum="-32768" Maximum="32768" Value="{Binding GasValue}" Height="10" Margin="0,0,0,5" Foreground="LimeGreen"
                                                  AbsLimit1="{Binding ResolvedProfile.OutGasMin}" AbsLimit1Name="VJoy Gas Min"
                                                  AbsLimit2="{Binding ResolvedProfile.OutGasMax}" AbsLimit2Name="VJoy Gas Max"
                                                  PctLimit1="{Binding ResolvedProfile.GasThreshold}" PctLimit1Name="Turbo Gas Threshold"
                                                  InvertPct="{Binding ResolvedProfile.InvertGas}"/>
                                
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Brake" VerticalAlignment="Center" />
                                <local:MonitorBar Grid.Row="2" Grid.Column="1" Minimum="-32768" Maximum="32768" Value="{Binding BrakeValue}" Height="10" Foreground="Red"
                                                  AbsLimit1="{Binding ResolvedProfile.OutBrakeMin}" AbsLimit1Name="VJoy Brake Min"
                                                  AbsLimit2="{Binding ResolvedProfile.OutBrakeMax}" AbsLimit2Name="VJoy Brake Max"
                                                  PctLimit1="{Binding ResolvedProfile.BrakeThreshold}" PctLimit1Name="Brake Threshold (Fast/Slow Attack)"
                                                  PctLimit2="{Binding ResolvedProfile.TbMinLimit}" PctLimit2Name="Trail Braking Limit"
                                                  InvertPct="{Binding ResolvedProfile.InvertBrake}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Expander>
            </Grid>
        </Grid>

        <!-- Drop Zone Visual Overlay (Visible when dragging a profile file into window) -->
        <Border x:Name="DropOverlay" 
                Visibility="Collapsed" 
                AllowDrop="True"
                IsHitTestVisible="True"
                Background="#F20F172A" 
                CornerRadius="8" 
                Margin="12" 
                BorderBrush="#3B82F6" 
                BorderThickness="2" 
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#3B82F6" Opacity="0.4"/>
            </Border.Effect>
            <StackPanel IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="56" Foreground="#60A5FA" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Drop Profile File Here to Import" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="Release your .vwh or .json profile preset to preview and apply settings" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
