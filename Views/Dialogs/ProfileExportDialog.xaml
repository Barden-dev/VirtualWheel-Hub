<ui:FluentWindow x:Class="SimRacingHub.Views.Dialogs.ProfileExportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Share Profile" Height="480" Width="520"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid>
        <ui:TitleBar Padding="10,0,0,0">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,-10,0,0">
                    <ui:SymbolIcon Symbol="Share24" FontSize="14" Margin="0,0,6,0" Foreground="#60A5FA"/>
                    <TextBlock Text="Share &amp; Export Profile" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Margin="24,40,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="Export Profile Preset" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBlock Text="Generate a Share Code for Discord or save a .vwh preset file to share with others." 
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,16" TextWrapping="Wrap"/>

                <!-- Preset Target Context Card -->
                <ui:Card Padding="12,10" Margin="0,0,0,16" Background="#1E293B" BorderBrush="#334155">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Grid.Column="0" Symbol="VehicleCarProfile24" FontSize="20" Foreground="#60A5FA" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="TARGET CONFIGURATION" FontSize="10.5" FontWeight="Bold" Foreground="#94A3B8"/>
                            <TextBlock x:Name="ContextText" Text="Le Mans Ultimate ➔ Hypercar ➔ Ferrari 499P" FontSize="12.5" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                        </StackPanel>
                    </Grid>
                </ui:Card>

                <!-- Profile Name -->
                <TextBlock Text="Preset Name" FontSize="12" Margin="0,0,0,4"/>
                <ui:TextBox x:Name="PresetNameBox" PlaceholderText="e.g. Wet Setup / Fast Road" Margin="0,0,0,12" />

                <!-- Author Name -->
                <TextBlock Text="Author (Optional)" FontSize="12" Margin="0,0,0,4"/>
                <ui:TextBox x:Name="AuthorBox" PlaceholderText="Your nickname" Margin="0,0,0,12" />

                <!-- Description -->
                <TextBlock Text="Description (Optional)" FontSize="12" Margin="0,0,0,4"/>
                <ui:TextBox x:Name="DescriptionBox" PlaceholderText="Notes on curve behavior, intended use, etc." Margin="0,0,0,8" />

                <TextBlock x:Name="StatusNoticeText" Text="" Foreground="#4ADE80" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Bottom Actions -->
            <Grid Grid.Row="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0" x:Name="CopyCodeButton" Content="Copy Share Code" Icon="{ui:SymbolIcon Copy24}" Appearance="Primary" Padding="12,6" Click="CopyCodeButton_Click" ToolTip="Copies a compact VWH1- share code to clipboard" />
                <ui:Button Grid.Column="1" x:Name="SaveFileButton" Content="Export to File (.vwh)..." Icon="{ui:SymbolIcon Save24}" Appearance="Secondary" Margin="10,0,0,0" HorizontalAlignment="Left" Padding="12,6" Click="SaveFileButton_Click" ToolTip="Saves a .vwh profile package file to disk" />
                <ui:Button Grid.Column="2" Content="Close" Appearance="Transparent" Padding="12,6" Click="CloseButton_Click" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
