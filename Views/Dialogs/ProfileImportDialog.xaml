<ui:FluentWindow x:Class="SimRacingHub.Views.Dialogs.ProfileImportDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Import Profile Preset" Height="680" Width="620"
        WindowBackdropType="Mica"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ExtendsContentIntoTitleBar="True"
        AllowDrop="True"
        PreviewDragEnter="Dialog_PreviewDragEnter"
        PreviewDragOver="Dialog_PreviewDragOver"
        PreviewDragLeave="Dialog_PreviewDragLeave"
        PreviewDrop="Dialog_PreviewDrop"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid AllowDrop="True">
        <ui:TitleBar Padding="10,0,0,0">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,-10,0,0">
                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,6,0" Foreground="#4ADE80"/>
                    <TextBlock Text="Import Profile Preset" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <Grid Margin="24,40,16,16" AllowDrop="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Margin="0,0,0,10" Padding="0,0,12,0" AllowDrop="True">
                <StackPanel AllowDrop="True" Margin="0,0,4,0">
                    <!-- Input Section: Share Code, File Browse or Drag & Drop -->
                    <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,12" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" AllowDrop="True">
                        <StackPanel AllowDrop="True">
                            <TextBlock Text="Share Code, Preset File, or Drag &amp; Drop" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                            <Grid AllowDrop="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox x:Name="ShareCodeInputBox" Grid.Column="0" PlaceholderText="Paste Share Code (VWH1-...) here..." TextChanged="ShareCodeInputBox_TextChanged" Margin="0,0,8,0" Padding="8,5"/>
                                <ui:Button x:Name="PasteClipboardButton" Grid.Column="1" Content="Paste" Icon="{ui:SymbolIcon ClipboardPaste24}" Appearance="Secondary" Click="PasteClipboardButton_Click" ToolTip="Paste from clipboard" Margin="0,0,6,0" Padding="10,5"/>
                                <ui:Button x:Name="BrowseFileButton" Grid.Column="2" Content="Browse..." Icon="{ui:SymbolIcon FolderOpen24}" Appearance="Secondary" Click="BrowseFileButton_Click" ToolTip="Choose a .vwh or .json preset file from disk" Padding="10,5"/>
                            </Grid>
                            <TextBlock x:Name="InputStatusText" Text="" FontSize="11.5" Foreground="#F87171" Margin="0,4,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>

                    <!-- Empty State Placeholder (when no preset is loaded yet) -->
                    <Border x:Name="EmptyStateBorder" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="20" Margin="0,10,0,10" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1" AllowDrop="True">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <ui:SymbolIcon Symbol="Document24" FontSize="36" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="No Preset Loaded" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <TextBlock Text="Paste a Share Code (VWH1-...) above, browse for a file, or drop a preset file (.vwh / .json) directly into this window or the main window." FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="440"/>
                        </StackPanel>
                    </Border>

                    <!-- Preset Details & Preview Panel (visible when a valid preset is loaded) -->
                    <StackPanel x:Name="PresetDetailsPanel" Visibility="Collapsed" AllowDrop="True">
                        <!-- Preset Header: Title, Author, Version -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="PresetNameText" Text="Ferrari 499P Wet Setup" FontSize="18" FontWeight="SemiBold" Foreground="#F8FAFC"/>
                                <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="" />
                            </StackPanel>

                            <Border Grid.Column="1" Background="#1E293B" BorderBrush="#3B82F6" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Top">
                                <TextBlock x:Name="VersionBadgeText" Text="v1.0.19" FontSize="11" FontWeight="Bold" Foreground="#60A5FA" />
                            </Border>
                        </Grid>

                        <!-- Description box (if present) -->
                        <Border x:Name="DescriptionBorder" Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="10,8" Margin="0,4,0,12" Visibility="Collapsed">
                            <TextBlock x:Name="DescriptionText" Text="" FontSize="11.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                        </Border>

                        <!-- Version Mismatch Warning (if preset is newer than current app) -->
                        <Border x:Name="VersionWarningBorder" Background="#2B1A28" BorderBrush="#831843" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,12" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="Info24" Foreground="#F472B6" FontSize="18" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Grid.Column="1" Text="This preset was created in a newer version of vWheel Hub. Supported settings will be imported seamlessly." FontSize="11.5" Foreground="#FBCFE8" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Target Context Card -->
                        <ui:Card Padding="12,10" Margin="0,0,0,12" Background="#182A1C" BorderBrush="#2A5C32">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Grid.Column="0" Symbol="VehicleCarProfile24" FontSize="20" Foreground="#4ADE80" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="TARGET SIMULATOR / VEHICLE" FontSize="10.5" FontWeight="Bold" Foreground="#86EFAC"/>
                                    <TextBlock x:Name="TargetContextText" Text="Le Mans Ultimate ➔ Hypercar ➔ Ferrari 499P" FontSize="12.5" FontWeight="SemiBold" Foreground="#F0FDF4"/>
                                </StackPanel>
                            </Grid>
                        </ui:Card>

                        <!-- Categorized Parameters Preview -->
                        <!-- 1. Steering Category -->
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="14" Foreground="#60A5FA" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Steering" FontWeight="SemiBold" FontSize="12.5" Foreground="#F8FAFC"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="ParamSteerSensText" Text="Sensitivity: 3.70 (1000 Hz)" FontSize="11.5" Margin="0,2,0,2"/>
                                        <TextBlock x:Name="ParamSteerGammaText" Text="Steer Gamma: 1.00 (Linear)" FontSize="11.5" Margin="0,2,0,2"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="ParamSteerSpeedSensText" Text="Speed-Sens: Disabled" FontSize="11.5" Margin="0,2,0,2"/>
                                        <TextBlock x:Name="ParamSteerLockText" Text="Steering Lock: Auto" FontSize="11.5" Margin="0,2,0,2"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 2. Pedals Category -->
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <ui:SymbolIcon Symbol="Flash24" FontSize="14" Foreground="#4ADE80" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Throttle &amp; Brake Dynamics" FontWeight="SemiBold" FontSize="12.5" Foreground="#F8FAFC"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="ParamThrottleDynamicsText" Text="Throttle: Fast 0.100s / Slow 0.300s" FontSize="11.5" Margin="0,2,0,2"/>
                                        <TextBlock x:Name="ParamThrottleGammaText" Text="Throttle Gamma: 1.00" FontSize="11.5" Margin="0,2,0,2"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="ParamBrakeDynamicsText" Text="Brake: Fast 0.050s / Slow 0.250s" FontSize="11.5" Margin="0,2,0,2"/>
                                        <TextBlock x:Name="ParamBrakeGammaText" Text="Brake Gamma: 1.00" FontSize="11.5" Margin="0,2,0,2"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 3. Telemetry & Assists Category -->
                        <Border Background="{DynamicResource ControlFillColorDefaultBrush}" CornerRadius="6" Padding="12,10" Margin="0,0,0,8" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <ui:SymbolIcon Symbol="Shield24" FontSize="14" Foreground="#F59E0B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Assists &amp; Telemetry" FontWeight="SemiBold" FontSize="12.5" Foreground="#F8FAFC"/>
                                </StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock x:Name="ParamAbsText" Text="ABS Helper: Disabled" FontSize="11.5" Margin="0,2,0,2"/>
                                        <TextBlock x:Name="ParamTcText" Text="TC Helper: Disabled" FontSize="11.5" Margin="0,2,0,2"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock x:Name="ParamTrailBrakingText" Text="Trail Braking: Active (20%)" FontSize="11.5" Margin="0,2,0,2"/>
                                        <TextBlock x:Name="ParamAudioText" Text="Slip Audio: Disabled" FontSize="11.5" Margin="0,2,0,2"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="1" Margin="0,10,8,0">
                <ui:Button x:Name="SaveToTargetSlotButton" Content="Save to Matching Car Slot (Auto-Detect)" Icon="{ui:SymbolIcon Save24}" Appearance="Primary" Margin="0,0,0,6" Click="SaveToTargetSlotButton_Click" HorizontalAlignment="Stretch" Padding="12,7" IsEnabled="False"/>
                <ui:Button x:Name="ApplyToCurrentContextButton" Content="Apply to Current Configuration" Icon="{ui:SymbolIcon Play24}" Appearance="Secondary" Margin="0,0,0,6" Click="ApplyToCurrentContextButton_Click" HorizontalAlignment="Stretch" Padding="12,7" IsEnabled="False"/>
                <ui:Button Content="Cancel" Appearance="Transparent" Click="CancelButton_Click" HorizontalAlignment="Right" Padding="12,5"/>
            </StackPanel>
        </Grid>

        <!-- Drop Zone Visual Overlay for Import Dialog -->
        <Border x:Name="DialogDropOverlay" 
                Visibility="Collapsed" 
                AllowDrop="True"
                IsHitTestVisible="True"
                Background="#F20F172A" 
                CornerRadius="8" 
                Margin="12" 
                BorderBrush="#3B82F6" 
                BorderThickness="2" 
                SnapsToDevicePixels="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#3B82F6" Opacity="0.4"/>
            </Border.Effect>
            <StackPanel IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="56" Foreground="#60A5FA" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="Drop Profile Preset Here to Load" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="Release your .vwh or .json preset to preview and apply settings" FontSize="13" Foreground="#94A3B8" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
