<Page x:Class="SimRacingHub.Views.Pages.BrakeLogicPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      xmlns:local="clr-namespace:SimRacingHub.Controls"
      xmlns:conv="clr-namespace:SimRacingHub.Converters" Title="BrakeLogicPage">
    <Page.Resources>
        <conv:PercentageConverter x:Key="PercentageConverter" />
    </Page.Resources>
    <StackPanel Margin="20">
            <TextBlock Text="Brake Logic" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>
            
            <ui:ToggleSwitch IsEnabled="False" IsChecked="False" Content="Use Telemetry ABS Helper" ToolTip="Uses live game telemetry to detect wheel lockup and automatically release brake pressure." Margin="0,0,0,5" />
            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left" Margin="0,0,0,6">
                <Run Text="When enabled, the app reads live game telemetry to detect wheel lockups and automatically drops brake pressure to regain grip, simulating a real ABS system." />
                
                
            </TextBlock>

            <!-- Boosty Subscription Promo Card (Auto-injected for OpenSource build) -->
            <ui:Card Padding="12,10" Margin="0,4,0,28" Background="#2B1A28" BorderBrush="#5B2449" HorizontalAlignment="Left" Width="600">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="Heart24" Foreground="#EC4899" FontSize="20" VerticalAlignment="Center" Margin="0,0,10,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Boosty Subscription Feature" FontWeight="SemiBold" FontSize="12.5" Foreground="#F472B6"/>
                        <TextBlock Text="This telemetry feature is available for Boosty subscribers." 
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11.5" TextWrapping="Wrap"/>
                    </StackPanel>

                    <ui:Button Grid.Column="2" 
                               Command="{Binding DataContext.OpenBoostyCommand, RelativeSource={RelativeSource AncestorType=Page}}" 
                               Content="Unlock on Boosty" 
                               Icon="Open24" 
                               Appearance="Primary" 
                               Padding="10,5" 
                               FontSize="12" 
                               VerticalAlignment="Center" 
                               Margin="10,0,0,0"/>
                </Grid>
            </ui:Card>
            <TextBlock Text="⚠️ Cannot be used together with Trail Braking. Enabling ABS Helper automatically disables Trail Braking." 
                       Foreground="#F59E0B" FontSize="11.5" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left" Margin="0,0,0,20" />

            <TextBlock Text="Fast Attack Threshold (%)" ToolTip="The pedal percentage at which the brake application speed slows down." Margin="0,0,0,5" />
            <ui:NumberBox Value="{Binding CurrentProfile.BrakeThreshold, Converter={StaticResource PercentageConverter}, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="100" ToolTip="The pedal percentage at which the brake application speed slows down." Margin="0,0,0,15" ClearButtonEnabled="False" Width="300" HorizontalAlignment="Left" />
            
            <TextBlock Text="Attack Speed (Fast)" ToolTip="Speed at which brake is applied below the fast attack threshold." Margin="0,0,0,5" />
            <ui:NumberBox Value="{Binding CurrentProfile.BrakeAttackFast, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="32768" ToolTip="Speed at which brake is applied below the fast attack threshold." Margin="0,0,0,15" ClearButtonEnabled="False" Width="300" HorizontalAlignment="Left" />
            
            <TextBlock Text="Attack Speed (Slow)" ToolTip="Speed at which brake is applied above the threshold to avoid instant lockups." Margin="0,0,0,5" />
            <ui:NumberBox Value="{Binding CurrentProfile.BrakeAttackSlow, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="32768" ToolTip="Speed at which brake is applied above the threshold to avoid instant lockups." Margin="0,0,0,15" ClearButtonEnabled="False" Width="300" HorizontalAlignment="Left" />
            
            <TextBlock Text="Release Rate (Decay)" ToolTip="Speed at which brake is released." Margin="0,0,0,5" />
            <ui:NumberBox Value="{Binding CurrentProfile.BrakeDecay, UpdateSourceTrigger=PropertyChanged}" Minimum="1" Maximum="32768" ToolTip="Speed at which brake is released." Margin="0,0,0,20" ClearButtonEnabled="False" Width="300" HorizontalAlignment="Left" />

            <TextBlock Text="Brake Non-Linearity (Gamma)" ToolTip="Curves brake response. Values &gt; 1.0 soften initial pedal travel to prevent trail braking lockups; values &lt; 1.0 give aggressive brake bite." Margin="0,0,0,5" />
            <ui:NumberBox Value="{Binding CurrentProfile.BrakeGamma, UpdateSourceTrigger=PropertyChanged}" Minimum="0.2" Maximum="3.0" SmallChange="0.05" LargeChange="0.10" ToolTip="Curves brake response." Margin="0,0,0,10" ClearButtonEnabled="False" Width="300" HorizontalAlignment="Left" />
            <local:ResponseCurveControl Gamma="{Binding CurrentProfile.BrakeGamma}" InputValue="{Binding DataContext.NormalizedBrake, RelativeSource={RelativeSource AncestorType=Page}}" CurveColor="#F87171" IsBipolar="False" Width="300" Height="180" HorizontalAlignment="Left" Margin="0,0,0,25" />
        </StackPanel>
</Page>
