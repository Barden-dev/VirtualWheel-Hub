<Page x:Class="SimRacingHub.Views.Pages.KeyBindingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:SimRacingHub.Controls"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      AllowDrop="True"
      Title="KeyBindingsPage">
    <StackPanel Margin="20">
        <TextBlock Text="Key Bindings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>
        
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="200" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            
            <TextBlock Grid.Row="0" Grid.Column="1" Text="Primary Key" Foreground="Gray" Margin="0,0,5,10" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Secondary Key" Foreground="Gray" Margin="5,0,0,10" HorizontalAlignment="Left" />
            
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Steer Left:" Margin="0,0,15,15" VerticalAlignment="Center" IsEnabled="{Binding ResolvedProfile.UseKeyboardOnlyMode}" />
            <local:KeyBindControl Grid.Row="1" Grid.Column="1" VirtualKeyCode="{Binding CurrentProfile.KeySteerLeft1}" BindingName="Steer Left" ToolTip="Primary key to turn steering wheel left in Keyboard Only mode." IsEnabled="{Binding ResolvedProfile.UseKeyboardOnlyMode}" Margin="0,0,5,15" />
            <local:KeyBindControl Grid.Row="1" Grid.Column="2" VirtualKeyCode="{Binding CurrentProfile.KeySteerLeft2}" BindingName="Steer Left" ToolTip="Secondary key to turn steering wheel left in Keyboard Only mode." IsEnabled="{Binding ResolvedProfile.UseKeyboardOnlyMode}" Margin="5,0,0,15" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Steer Right:" Margin="0,0,15,15" VerticalAlignment="Center" IsEnabled="{Binding ResolvedProfile.UseKeyboardOnlyMode}" />
            <local:KeyBindControl Grid.Row="2" Grid.Column="1" VirtualKeyCode="{Binding CurrentProfile.KeySteerRight1}" BindingName="Steer Right" ToolTip="Primary key to turn steering wheel right in Keyboard Only mode." IsEnabled="{Binding ResolvedProfile.UseKeyboardOnlyMode}" Margin="0,0,5,15" />
            <local:KeyBindControl Grid.Row="2" Grid.Column="2" VirtualKeyCode="{Binding CurrentProfile.KeySteerRight2}" BindingName="Steer Right" ToolTip="Secondary key to turn steering wheel right in Keyboard Only mode." IsEnabled="{Binding ResolvedProfile.UseKeyboardOnlyMode}" Margin="5,0,0,15" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Throttle:" Margin="0,0,15,15" VerticalAlignment="Center" />
            <local:KeyBindControl Grid.Row="3" Grid.Column="1" VirtualKeyCode="{Binding CurrentProfile.KeyGas1}" BindingName="Throttle" ToolTip="Primary key to apply throttle." Margin="0,0,5,15" />
            <local:KeyBindControl Grid.Row="3" Grid.Column="2" VirtualKeyCode="{Binding CurrentProfile.KeyGas2}" BindingName="Throttle" ToolTip="Secondary key to apply throttle. Pressing both triggers Turbo attack." Margin="5,0,0,15" />
            
            <TextBlock Grid.Row="4" Grid.Column="0" Text="Brake:" Margin="0,0,15,15" VerticalAlignment="Center" />
            <local:KeyBindControl Grid.Row="4" Grid.Column="1" VirtualKeyCode="{Binding CurrentProfile.KeyBrake1}" BindingName="Brake" ToolTip="Primary key to apply brake." Margin="0,0,5,15" />
            <local:KeyBindControl Grid.Row="4" Grid.Column="2" VirtualKeyCode="{Binding CurrentProfile.KeyBrake2}" BindingName="Brake" ToolTip="Secondary key to apply brake. Pressing both triggers Turbo attack." Margin="5,0,0,15" />
            
            <TextBlock Grid.Row="5" Grid.Column="0" Text="Shift Up:" Margin="0,0,15,15" VerticalAlignment="Center" />
            <local:KeyBindControl Grid.Row="5" Grid.Column="1" VirtualKeyCode="{Binding CurrentProfile.KeyShiftUp1}" BindingName="Shift Up" ToolTip="Primary key to shift gear up." Margin="0,0,5,15" />
            <local:KeyBindControl Grid.Row="5" Grid.Column="2" VirtualKeyCode="{Binding CurrentProfile.KeyShiftUp2}" BindingName="Shift Up" ToolTip="Secondary key to shift gear up." Margin="5,0,0,15" />
            
            <TextBlock Grid.Row="6" Grid.Column="0" Text="Shift Down:" Margin="0,0,15,15" VerticalAlignment="Center" />
            <local:KeyBindControl Grid.Row="6" Grid.Column="1" VirtualKeyCode="{Binding CurrentProfile.KeyShiftDown1}" BindingName="Shift Down" ToolTip="Primary key to shift gear down." Margin="0,0,5,15" />
            <local:KeyBindControl Grid.Row="6" Grid.Column="2" VirtualKeyCode="{Binding CurrentProfile.KeyShiftDown2}" BindingName="Shift Down" ToolTip="Secondary key to shift gear down." Margin="5,0,0,15" />
            
            <TextBlock Grid.Row="7" Grid.Column="0" Text="Center Steer:" Margin="0,0,15,15" VerticalAlignment="Center" />
            <local:KeyBindControl Grid.Row="7" Grid.Column="1" VirtualKeyCode="{Binding CurrentProfile.KeyCenterSteering1}" BindingName="Center Steer" ToolTip="Primary key to snap steering wheel to center instantly." Margin="0,0,5,15" />
            <local:KeyBindControl Grid.Row="7" Grid.Column="2" VirtualKeyCode="{Binding CurrentProfile.KeyCenterSteering2}" BindingName="Center Steer" ToolTip="Secondary key to snap steering wheel to center instantly." Margin="5,0,0,15" />
            
            <TextBlock Grid.Row="8" Grid.Column="0" Text="Toggle Hub:" Margin="0,0,15,15" VerticalAlignment="Center" />
            <local:KeyBindControl Grid.Row="8" Grid.Column="1" VirtualKeyCode="{Binding CurrentProfile.KeyToggleHub1}" BindingName="Toggle Hub" ToolTip="Primary key to toggle Hub Active state on/off." Margin="0,0,5,15" />
            <local:KeyBindControl Grid.Row="8" Grid.Column="2" VirtualKeyCode="{Binding CurrentProfile.KeyToggleHub2}" BindingName="Toggle Hub" ToolTip="Secondary key to toggle Hub Active state on/off." Margin="5,0,0,15" />
            
            <TextBlock Grid.Row="9" Grid.Column="0" Text="Toggle Lock:" Margin="0,0,15,15" VerticalAlignment="Center" />
            <local:KeyBindControl Grid.Row="9" Grid.Column="1" VirtualKeyCode="{Binding CurrentProfile.KeyToggleLock1}" BindingName="Toggle Lock" ToolTip="Primary key to toggle mouse lock on/off." Margin="0,0,5,15" />
            <local:KeyBindControl Grid.Row="9" Grid.Column="2" VirtualKeyCode="{Binding CurrentProfile.KeyToggleLock2}" BindingName="Toggle Lock" ToolTip="Secondary key to toggle mouse lock on/off." Margin="5,0,0,15" />

            <TextBlock Grid.Row="10" Grid.Column="0" Text="Unlock Cursor (Hold):" Margin="0,0,15,0" VerticalAlignment="Center" />
            <local:KeyBindControl Grid.Row="10" Grid.Column="1" VirtualKeyCode="{Binding CurrentProfile.KeyUnlockCursor1}" BindingName="Unlock Cursor (Hold)" ToolTip="Primary key to temporarily unlock cursor and freeze steering while held (e.g. for looking around)." Margin="0,0,5,0" />
            <local:KeyBindControl Grid.Row="10" Grid.Column="2" VirtualKeyCode="{Binding CurrentProfile.KeyUnlockCursor2}" BindingName="Unlock Cursor (Hold)" ToolTip="Secondary key to temporarily unlock cursor and freeze steering while held (e.g. for looking around)." Margin="5,0,0,0" />
        </Grid>



        <TextBlock Text="⚠️ Steer Left and Steer Right key bindings are active only when 'Keyboard only' mode is enabled in Steering settings." 
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,20,0,0" TextWrapping="Wrap" MaxWidth="600" HorizontalAlignment="Left" />
    </StackPanel>
</Page>
