<Page x:Class="SimRacingHub.Views.Pages.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      xmlns:local="clr-namespace:SimRacingHub.Controls" Title="DashboardPage">
    <StackPanel Margin="30">
        
        <!-- Context Selection Row -->
        <Grid Margin="0,0,0,30">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Labels -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Game" ToolTip="Selects the profile associated with this specific game." Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,5" FontSize="12"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Class" ToolTip="Selects the profile associated with this specific car class." Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,5" FontSize="12"/>
            <TextBlock Grid.Row="0" Grid.Column="4" Text="Car" ToolTip="Selects the profile associated with this specific car model." Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,5" FontSize="12"/>

            <!-- Row 1: Inputs & Badges & Toggles -->
            <ComboBox Grid.Row="1" Grid.Column="0" ItemsSource="{Binding AvailableGames}" Text="{Binding CurrentContext.Game, UpdateSourceTrigger=PropertyChanged}" ToolTip="Selects the profile associated with this specific game." IsEditable="True" Width="150" Margin="0,0,10,0">
                <ComboBox.Style>
                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding GameDetection.AutoDetectEnabled}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>
            </ComboBox>

            <ui:SymbolIcon Grid.Row="1" Grid.Column="1" Symbol="ChevronRight24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>

            <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding AvailableClasses}" Text="{Binding CurrentContext.CarClass, UpdateSourceTrigger=PropertyChanged}" ToolTip="Selects the profile associated with this specific car class." IsEditable="True" Width="150" Margin="0,0,10,0">
                <ComboBox.Style>
                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding GameDetection.AutoDetectEnabled}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>
            </ComboBox>

            <ui:SymbolIcon Grid.Row="1" Grid.Column="3" Symbol="ChevronRight24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>

            <ComboBox Grid.Row="1" Grid.Column="4" ItemsSource="{Binding AvailableCars}" Text="{Binding CurrentContext.Car, UpdateSourceTrigger=PropertyChanged}" ToolTip="Selects the profile associated with this specific car model." IsEditable="True" Width="200" Margin="0,0,15,0">
                <ComboBox.Style>
                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                        <Setter Property="IsEnabled" Value="True"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding GameDetection.AutoDetectEnabled}" Value="True">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentContext.CarClass}" Value="">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentContext.CarClass}" Value="{x:Null}">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ComboBox.Style>
            </ComboBox>

            <ui:ToggleSwitch Grid.Row="1" Grid.Column="5" IsChecked="{Binding GameDetection.AutoDetectEnabled}" Content="Auto-Detect" ToolTip="Automatically switches to the correct profile based on live telemetry." VerticalAlignment="Center" />
        </Grid>

        <TextBlock Text="Welcome to vWheel Hub" FontSize="26" FontWeight="SemiBold" Margin="0,0,0,20"/>
        
        <!-- vJoy Status & Diagnostic Card -->
        <ui:Card Padding="16,14" Margin="0,0,0,16">
            <ui:Card.Style>
                <Style TargetType="ui:Card">
                    <Setter Property="Background" Value="#182A1C"/>
                    <Setter Property="BorderBrush" Value="#2A5C32"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding VJoyDiagnostic.IsValid}" Value="False">
                            <Setter Property="Background" Value="#2D1A1A"/>
                            <Setter Property="BorderBrush" Value="#6B2828"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ui:Card.Style>
            <StackPanel>
                <!-- Top Row: Icon & Text -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon -->
                    <ui:SymbolIcon Grid.Column="0" FontSize="24" VerticalAlignment="Top" Margin="0,2,14,0">
                        <ui:SymbolIcon.Style>
                            <Style TargetType="ui:SymbolIcon">
                                <Setter Property="Symbol" Value="CheckmarkCircle24"/>
                                <Setter Property="Foreground" Value="#4ADE80"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VJoyDiagnostic.IsValid}" Value="False">
                                        <Setter Property="Symbol" Value="Warning24"/>
                                        <Setter Property="Foreground" Value="#F87171"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:SymbolIcon.Style>
                    </ui:SymbolIcon>

                    <!-- Text info -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="Virtual Joystick (vJoy)" FontWeight="SemiBold" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding VJoyDiagnostic.DeviceStatusText, StringFormat='[{0}]'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding VJoyDiagnostic.SummaryMessage}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                        
                        <TextBlock Text="{Binding VJoyDiagnostic.ActionableAdvice}" 
                                   Foreground="#FCA5A5" 
                                   FontSize="11" 
                                   TextWrapping="Wrap" 
                                   Margin="0,4,0,0"
                                   Visibility="{Binding VJoyDiagnostic.IsNotValid, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>

                <!-- Bottom Row: Action Buttons under Text -->
                <WrapPanel Margin="38,4,0,0">
                    <!-- Configuration Buttons (Visible only when vJoy Driver IS installed, but device needs setup) -->
                    <ui:Button Command="{Binding AutoConfigureVJoyCommand}" 
                               Content="Auto-Fix vJoy" 
                               Icon="Flash24" 
                               Appearance="Primary" 
                               Margin="0,0,8,8"
                               ToolTip="Automatically configures vJoy Device #1 (X,Y,Z axes + 8 buttons) via CLI."
                               Visibility="{Binding VJoyDiagnostic.CanConfigureDevice, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <ui:Button Command="{Binding OpenVJoyConfigCommand}" 
                               Content="Open GUI" 
                               Icon="Wrench24" 
                               Appearance="Secondary" 
                               Margin="0,0,8,8"
                               ToolTip="Launches vJoyConf.exe graphical user interface for manual setup."
                               Visibility="{Binding VJoyDiagnostic.CanConfigureDevice, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <ui:Button Command="{Binding OpenVJoyFolderCommand}" 
                               Content="Open Folder" 
                               Icon="Folder24" 
                               Appearance="Secondary" 
                               Margin="0,0,8,8"
                               ToolTip="Opens vJoy installation directory (C:\Program Files\vJoy\x64)."
                               Visibility="{Binding VJoyDiagnostic.CanConfigureDevice, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- Download Button (Visible ONLY when vJoy Driver is NOT installed on PC) -->
                    <ui:Button Command="{Binding OpenVJoyDownloadCommand}" 
                               Content="Get vJoy" 
                               Icon="ArrowDownload24" 
                               Appearance="Primary" 
                               Margin="0,0,8,8"
                               ToolTip="Downloads vJoy driver installer from GitHub."
                               Visibility="{Binding VJoyDiagnostic.IsDriverMissing, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                    <!-- Recheck Button -->
                    <ui:Button Command="{Binding RunVJoyDiagnosticCommand}" 
                               Content="{Binding RecheckButtonText}" 
                               Icon="{Binding RecheckButtonIcon}" 
                               Appearance="Secondary"
                               Margin="0,0,8,8"
                               IsEnabled="{Binding CanRecheck}"/>

                    <!-- Ask in Discord Button (Visible when any diagnostic issue is present) -->
                    <ui:Button Command="{Binding OpenDiscordCommand}" 
                               Content="Ask in Discord" 
                               Icon="Chat24" 
                               Appearance="Secondary"
                               Margin="0,0,8,8"
                               Visibility="{Binding VJoyDiagnostic.IsNotValid, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </WrapPanel>
            </StackPanel>
        </ui:Card>

        <!-- Game Telemetry Plugin Diagnostic Card -->
        <ui:Card Padding="16,14" Margin="0,0,0,16"
                 Visibility="{Binding GamePluginDiagnostic.IsActionRequired, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <ui:Card.Style>
                <Style TargetType="ui:Card">
                    <Setter Property="Background" Value="#2D1A1A"/>
                    <Setter Property="BorderBrush" Value="#6B2828"/>
                </Style>
            </ui:Card.Style>
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon Grid.Column="0" Symbol="PuzzlePiece24" Foreground="#F87171" FontSize="24" VerticalAlignment="Top" Margin="0,2,14,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="{Binding GamePluginDiagnostic.GameDisplayName, StringFormat='Telemetry Plugin: {0}'}" FontWeight="SemiBold" FontSize="14" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding GamePluginDiagnostic.Status, StringFormat='[{0}]'}" Foreground="#FCA5A5" FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding GamePluginDiagnostic.StatusMessage}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <WrapPanel Margin="38,4,0,0">
                    <ui:Button Command="{Binding InstallGamePluginCommand}" 
                               Content="Auto-Install Plugin" 
                               Icon="Flash24" 
                               Appearance="Primary" 
                               Margin="0,0,8,8"
                               ToolTip="Copies telemetry plugin DLL into game directory. If the game is currently running, the app will automatically close it and install the plugin."/>

                    <ui:Button Command="{Binding LocateGameFolderCommand}" 
                               Content="Locate Game Folder" 
                               Icon="Folder24" 
                               Appearance="Secondary" 
                               Margin="0,0,8,8"
                               ToolTip="Manually select game installation folder."/>
                </WrapPanel>
            </StackPanel>
        </ui:Card>

        <!-- Active Profile Card -->
        <ui:Card Background="{DynamicResource ControlFillColorDefaultBrush}" Padding="16,14" Margin="0,0,0,12">
            <StackPanel>
                <!-- Top status row with label and pill badge -->
                <Grid Margin="0,0,0,8">
                    <TextBlock Text="Active profile" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                    <Border HorizontalAlignment="Right" Background="#1D3E6E" BorderBrush="#2B5899" BorderThickness="1" CornerRadius="12" Padding="10,2,10,3">
                        <TextBlock Text="{Binding CurrentContext.DisplayPath, FallbackValue='Universal'}" Foreground="#60A5FA" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </Grid>
                
                <!-- Descriptive heading -->
                <TextBlock FontSize="17" FontWeight="SemiBold" Margin="0,0,0,4">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{Binding CurrentContext.DisplayPath}"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentContext.DisplayPath}" Value="Universal">
                                    <Setter Property="Text" Value="Applies to all games"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                
                <!-- Explanation subtitle -->
                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="Custom tuned profile active for this specific game context."/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentContext.DisplayPath}" Value="Universal">
                                    <Setter Property="Text" Value="Used as a fallback when a game is not auto-detected or has no dedicated profile."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </ui:Card>
        
        <!-- Independent Help Expander -->
        <Expander ExpandDirection="Down" Margin="0,0,0,30" IsExpanded="False">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="QuestionCircle24" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,8,0" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="How do profiles and inheritance work?" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
                </StackPanel>
            </Expander.Header>
            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6" Padding="15" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="• Creating a Class or Car profile copies parameters from its parent profile at creation time." TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="• Existing child profiles preserve their own saved values and do not change automatically when the parent is edited." TextWrapping="Wrap" Margin="0,0,0,6" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="• 'Universal' acts as an isolated fallback profile when no dedicated game profile exists." TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </Expander>
        
        <StackPanel Margin="0,0,0,30">
            <TextBlock Text="Quick Settings" FontSize="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"/>
            <ui:Card Background="{DynamicResource ControlFillColorDefaultBrush}" HorizontalAlignment="Left" MinWidth="450">
                <StackPanel>
                    <ui:ToggleSwitch IsChecked="{Binding AutoStartHub, UpdateSourceTrigger=PropertyChanged}" Content="Auto-start hub on launch" ToolTip="Automatically activates the hub when vWheel Hub starts." Margin="0,0,0,12" />
                    
                    <ui:ToggleSwitch IsChecked="{Binding AutoDetectOnStartup, UpdateSourceTrigger=PropertyChanged}" Content="Auto-detect games on launch" ToolTip="Automatically enables game auto-detection when vWheel Hub starts up." Margin="0,0,0,20" />

                    <TextBlock Text="Hub Processing Rate (Hz)" ToolTip="Controls physics update frequency per second." Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,5"/>
                    <ui:NumberBox Value="{Binding CurrentProfile.PollingRate, UpdateSourceTrigger=PropertyChanged}" Minimum="10" Maximum="5000" SmallChange="50" LargeChange="100" ClearButtonEnabled="False" Width="150" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                    <TextBlock Text="1000 Hz recommended; reduce if CPU usage is high." Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11"/>
                </StackPanel>
            </ui:Card>
        </StackPanel>
        
    </StackPanel>
</Page>
