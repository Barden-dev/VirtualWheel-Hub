<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SimRacingHub.Avalonia.App"
             RequestedThemeVariant="Dark">
    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes><ColorPaletteResources x:Key="Dark" Accent="#60CDFF" RegionColor="#202020"/></FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://vWheelHub/Themes/WinUi.axaml" />
    </Application.Styles>

</Application>
