<UserControl xmlns:loc="clr-namespace:SimRacingHub.Application.Localization;assembly=vWheelHub.Application" xmlns:controls="clr-namespace:SimRacingHub.Avalonia.Controls" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:appVm="clr-namespace:SimRacingHub.Application.Features.AppSettings;assembly=vWheelHub.Application" xmlns:conv="clr-namespace:SimRacingHub.Avalonia.Converters" mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="1200" x:Class="SimRacingHub.Avalonia.Views.AppSettings.AppSettingsView" x:DataType="appVm:AppSettingsViewModel" x:CompileBindings="True" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <ScrollViewer Classes="hub-scroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="0,0,16,24">
            <StackPanel Spacing="4">
                <TextBlock Text="{DynamicResource Ui_7d907ad785cc}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="{DynamicResource Ui_d7c7da8b1d85}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Name="UpdateBannerCard" IsVisible="{Binding IsUpdateAvailable}" Background="#1E3A8A" BorderBrush="{DynamicResource SystemAccentColorBrush}" BorderThickness="1" CornerRadius="6" Padding="16,12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <PathIcon Data="{StaticResource IconArrowRight}" Width="16" Height="16" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{DynamicResource Ui_2fc10512fb73}" FontWeight="SemiBold" FontSize="13" Foreground="#93C5FD"/>
                            <Border Background="{DynamicResource SystemAccentColorBrush}" CornerRadius="4" Padding="6,2">
                                <TextBlock Name="LatestVersionText" Text="{Binding LatestVersion, StringFormat='v{0}'}" FontWeight="SemiBold" FontSize="10.5" Foreground="White"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Updates.UpdateStatusMessage}" FontSize="11.5" Foreground="#BFDBFE" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Button Classes="accent" Name="OpenUpdateUrlButton" Content="{DynamicResource Ui_6ea67f029794}" Command="{Binding OpenUpdateUrlCommand}" Padding="12,6" CornerRadius="4" FontSize="11" FontWeight="SemiBold"/>
                        <Button Name="DismissUpdateButton" Content="{DynamicResource Common_Dismiss}" Command="{Binding DismissUpdateBannerCommand}" Padding="10,6" CornerRadius="4" FontSize="11"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Name="StartupPreferencesCard" Classes="hub-card" Padding="16,14">
                <StackPanel Spacing="14">
                    <TextBlock Text="{DynamicResource Desktop_Preferences}" FontSize="14" FontWeight="SemiBold"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Desktop_AutoStartHub}" FontSize="12.5" FontWeight="Medium"/>
                            <TextBlock Text="{DynamicResource Desktop_AutoStartHubHint}" Classes="hub-secondary" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Name="AutoStartHubSwitch" Grid.Column="1" IsChecked="{Binding AutoStartHub, Mode=TwoWay}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{DynamicResource Desktop_AutoStartHub}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Desktop_StartMinimized}" FontSize="12.5" FontWeight="Medium"/>
                            <TextBlock Text="{DynamicResource Desktop_StartMinimizedHint}" Classes="hub-secondary" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Name="StartMinimizedSwitch" Grid.Column="1" IsChecked="{Binding StartMinimized, Mode=TwoWay}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{DynamicResource Desktop_StartMinimized}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Desktop_MinimizeToTray}" FontSize="12.5" FontWeight="Medium"/>
                            <TextBlock Text="{DynamicResource Desktop_MinimizeToTrayHint}" Classes="hub-secondary" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Name="MinimizeToTraySwitch" Grid.Column="1" IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{DynamicResource Desktop_MinimizeToTray}"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Desktop_CloseToTray}" FontSize="12.5" FontWeight="Medium"/>
                            <TextBlock Text="{DynamicResource Desktop_CloseToTrayHint}" Classes="hub-secondary" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Name="CloseToTraySwitch" Grid.Column="1" IsChecked="{Binding CloseToTray, Mode=TwoWay}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{DynamicResource Desktop_CloseToTray}"/>
                    </Grid>
                    <TextBlock Text="{DynamicResource Desktop_TrayFallback}" Classes="hub-secondary" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16,14">
                <StackPanel Spacing="14">
                    <TextBlock Text="{DynamicResource Ui_127c3f97b7a6}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{DynamicResource Ui_d1c76800f087}" FontWeight="Medium" FontSize="12.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Language_Description}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,12,0"/>
                        </StackPanel>
                        <ComboBox Name="LanguageSelector" Grid.Column="1" MinWidth="210" MaxWidth="280"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  MaxDropDownHeight="320" DropDownOpened="LanguageSelectorOpened"
                                  AutomationProperties.Name="{DynamicResource Ui_d1c76800f087}"
                                  ItemsSource="{Binding AvailableLanguages}"
                                  SelectedItem="{Binding SelectedLanguageInfo, Mode=TwoWay}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="loc:LanguageInfo">
                                    <TextBlock Text="{Binding DisplayName}" ToolTip.Tip="{Binding CultureCode}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>
                    <Separator Background="{DynamicResource CardStrokeColorDefaultBrush}" Height="1"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                        <StackPanel Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Desktop_MouseLockSounds}" FontSize="12.5" FontWeight="Medium"/>
                            <TextBlock Text="{DynamicResource Desktop_MouseLockSoundsHint}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Name="MouseLockSoundSwitch" Grid.Column="1" IsChecked="{Binding MouseLockSoundsEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                                      AutomationProperties.Name="{DynamicResource Desktop_MouseLockSounds}"/>
                    </Grid>
                    <Separator Background="{DynamicResource CardStrokeColorDefaultBrush}" Height="1"/>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{DynamicResource Ui_9e4a53b33b0d}" FontWeight="Medium" FontSize="12.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Text="{DynamicResource Ui_b4a4c70ccf3a}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ToggleSwitch Name="AutoDetectGameSwitch" Grid.Column="1" IsChecked="{Binding AutoDetectGame}" OnContent="{DynamicResource Ui_On}" OffContent="{DynamicResource Ui_Off}" VerticalAlignment="Center"/>
                    </Grid>
                    <Separator Background="{DynamicResource CardStrokeColorDefaultBrush}" Height="1"/>
                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{DynamicResource Ui_cd64194d42f7}" FontWeight="Medium" FontSize="12.5" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Name="CurrentVersionText" Text="{Binding FullVersionString}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Name="UpdateStatusText" Text="{Binding Updates.UpdateStatusMessage}" FontSize="11" Foreground="{DynamicResource SystemAccentColorBrush}" IsVisible="{Binding Updates.UpdateStatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Classes="accent" Name="CheckForUpdatesButton" Grid.Column="1" Content="{DynamicResource Ui_9ed79ee9b212}" Command="{Binding Updates.CheckForUpdatesCommand}" IsEnabled="{Binding !Updates.IsCheckingForUpdates}" Padding="12,6" CornerRadius="4" FontSize="11" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16,14">
                <StackPanel Spacing="12">
                    <TextBlock Text="{DynamicResource Settings_WebLinks}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <WrapPanel Orientation="Horizontal">
                        <Button Name="OpenGitHubButton" Command="{Binding OpenGitHubCommand}" Padding="12,8" CornerRadius="4" FontSize="11" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <PathIcon Data="{StaticResource IconGitHub}" Width="16" Height="16"/>
                                <TextBlock Text="{DynamicResource Ui_b7c6095c80ba}"/>
                            </StackPanel>
                        </Button>
                        <Button Name="OpenReleasesButton" Command="{Binding OpenReleasesCommand}" Padding="12,8" CornerRadius="4" FontSize="11" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <PathIcon Data="{StaticResource IconArrowDownload}" Width="16" Height="16"/>
                                <TextBlock Text="{DynamicResource Ui_4db779894a56}"/>
                            </StackPanel>
                        </Button>
                        <Button Name="OpenDocsButton" Command="{Binding OpenDocumentationCommand}" Padding="12,8" CornerRadius="4" FontSize="11" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <PathIcon Data="{StaticResource IconDocument}" Width="16" Height="16"/>
                                <TextBlock Text="{DynamicResource Ui_2ef57cfafd92}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Name="CommunityLinksCard" Classes="hub-card" Padding="16,14">
                <StackPanel Spacing="12">
                    <TextBlock Text="{DynamicResource Settings_CommunityLinks}" FontSize="14" FontWeight="SemiBold"/>
                    <WrapPanel Orientation="Horizontal">
                        <Button Name="OpenDiscordButton" Command="{Binding OpenDiscordCommand}" Padding="12,8" CornerRadius="4" FontSize="11" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <PathIcon Data="{StaticResource IconDiscord}" Width="16" Height="16"/>
                                <TextBlock Text="{DynamicResource Ui_3da42b09f945}"/>
                            </StackPanel>
                        </Button>
                        <Button Name="OpenBoostyButton" Command="{Binding OpenBoostyCommand}" Foreground="#F59E0B" Padding="12,8" CornerRadius="4" FontSize="11" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <PathIcon Data="{StaticResource IconBoosty}" Width="16" Height="16"/>
                                <TextBlock Text="{DynamicResource Ui_6dddc1bfad77}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <Border Name="LocalDirectoriesCard" Classes="hub-card" Padding="16,14">
                <StackPanel Spacing="12">
                    <TextBlock Text="{DynamicResource Settings_LocalDirectories}" FontSize="14" FontWeight="SemiBold"/>
                    <WrapPanel Orientation="Horizontal">
                        <Button Name="OpenProfilesFolderButton" Command="{Binding OpenProfilesFolderCommand}" Padding="12,8" CornerRadius="4" FontSize="11" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <PathIcon Data="{StaticResource IconFolder}" Width="16" Height="16"/>
                                <TextBlock Text="{DynamicResource Ui_26cda12d5ef9}"/>
                            </StackPanel>
                        </Button>
                        <Button Name="OpenLogsFolderButton" Command="{Binding OpenLogsFolderCommand}" Padding="12,8" CornerRadius="4" FontSize="11" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <PathIcon Data="{StaticResource IconDocument}" Width="16" Height="16"/>
                                <TextBlock Text="{DynamicResource Ui_b74bf22af826}"/>
                            </StackPanel>
                        </Button>
                        <Button Name="OpenSettingsFolderButton" Command="{Binding OpenSettingsFolderCommand}" Padding="12,8" CornerRadius="4" FontSize="11" Margin="0,0,8,8">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <PathIcon Data="{StaticResource IconSettings}" Width="16" Height="16"/>
                                <TextBlock Text="{DynamicResource Ui_102815389c77}"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </Border>
            <TextBlock Name="VersionFooterText" Text="{Binding FullVersionString}" FontSize="11" Foreground="#475569" HorizontalAlignment="Center" Margin="0,4,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
