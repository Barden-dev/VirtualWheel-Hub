<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:steeringVm="clr-namespace:SimRacingHub.Application.Features.Steering;assembly=vWheelHub.Application" xmlns:conv="clr-namespace:SimRacingHub.Avalonia.Converters" xmlns:controls="clr-namespace:SimRacingHub.Avalonia.Controls" mc:Ignorable="d" d:DesignWidth="850" d:DesignHeight="1300" x:Name="SteeringRoot" x:Class="SimRacingHub.Avalonia.Views.Steering.SteeringView" x:DataType="steeringVm:SteeringViewModel" x:CompileBindings="True" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <UserControl.Resources>
        <conv:NullableNumericConverter x:Key="NumericConv"/>
        <conv:BooleanToBrushConverter x:Key="StatusBrushConv"/>
    </UserControl.Resources>
    <ScrollViewer Classes="hub-scroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="18" Margin="0,0,16,24">
            <StackPanel Spacing="4" IsVisible="{Binding ShowPageHeader, ElementName=SteeringRoot}">
                <TextBlock Text="{DynamicResource Ui_cddefdcc39b1}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <TextBlock Text="{DynamicResource Ui_f12d9789f48a}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <ToggleSwitch Name="KeyboardModeSwitch" IsChecked="{Binding Keyboard.EffectiveUseKeyboardOnlyMode, Mode=TwoWay}" Content="{DynamicResource Ui_4eb746e348f9}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{DynamicResource Ui_2eb430faa424}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Name="ResetKeyboardModeButton" Classes="setting-revert" controls:SettingRevert.Session="{Binding ProfileSession}" controls:SettingRevert.PropertyName="UseKeyboardOnlyMode" Content="{DynamicResource Ui_RestoreSetting}" ToolTip.Tip="{DynamicResource Ui_RestoreSettingHint}"/>
                    </Grid>
                    <Border IsVisible="{Binding !Keyboard.EffectiveUseKeyboardOnlyMode}" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                        <Grid ColumnDefinitions="*,150,Auto" ColumnSpacing="12">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{DynamicResource Ui_cdd6daa893b1}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                <TextBlock Text="{DynamicResource Ui_d93e5286e800}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <NumericUpDown Grid.Column="1" Name="MouseSensitivityBox" Value="{Binding Mouse.EffectiveMouseSensitivity, Converter={StaticResource NumericConv}, Mode=TwoWay}" Minimum="0.01" Maximum="100.0" Increment="0.1" FormatString="0.00" Width="150" VerticalAlignment="Center" FontSize="13" MinHeight="32"/>
                            <Button Grid.Column="2" Name="ResetMouseSensitivityButton" Classes="setting-revert" controls:SettingRevert.Session="{Binding ProfileSession}" controls:SettingRevert.PropertyName="MouseSensitivity" Content="{DynamicResource Ui_RestoreSetting}" ToolTip.Tip="{DynamicResource Ui_RestoreSettingHint}"/>
                        </Grid>
                    </Border>
                    <Border IsVisible="{Binding Keyboard.EffectiveUseKeyboardOnlyMode}" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{DynamicResource Ui_58326a43567c}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                            <Grid ColumnDefinitions="*,150,Auto" ColumnSpacing="12">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{DynamicResource Ui_bbb99a3aa5b4}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{DynamicResource Ui_1d84728ea880}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <NumericUpDown Grid.Column="1" Name="KeySteerRampUpMsBox" Value="{Binding Keyboard.EffectiveKeySteerRampUpMs, Converter={StaticResource NumericConv}, Mode=TwoWay}" Minimum="1" Maximum="5000" Increment="10" FormatString="{DynamicResource Ui_NumberMsFormat}" Width="150" VerticalAlignment="Center" FontSize="13" MinHeight="32"/>
                                <Button Grid.Column="2" Name="ResetKeySteerRampUpButton" Classes="setting-revert" controls:SettingRevert.Session="{Binding ProfileSession}" controls:SettingRevert.PropertyName="KeySteerRampUpMs" Content="{DynamicResource Ui_RestoreSetting}" ToolTip.Tip="{DynamicResource Ui_RestoreSettingHint}"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,150,Auto" ColumnSpacing="12">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <TextBlock Text="{DynamicResource Ui_f87df89a0839}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{DynamicResource Ui_cf7e2003932f}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <NumericUpDown Grid.Column="1" Name="KeySteerRampDownMsBox" Value="{Binding Keyboard.EffectiveKeySteerRampDownMs, Converter={StaticResource NumericConv}, Mode=TwoWay}" Minimum="1" Maximum="5000" Increment="10" FormatString="{DynamicResource Ui_NumberMsFormat}" Width="150" VerticalAlignment="Center" FontSize="13" MinHeight="32"/>
                                <Button Grid.Column="2" Name="ResetKeySteerRampDownButton" Classes="setting-revert" controls:SettingRevert.Session="{Binding ProfileSession}" controls:SettingRevert.PropertyName="KeySteerRampDownMs" Content="{DynamicResource Ui_RestoreSetting}" ToolTip.Tip="{DynamicResource Ui_RestoreSettingHint}"/>
                            </Grid>
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Grid.Column="0" Spacing="2">
                                    <ToggleSwitch Name="KeySteerSnapSwitch" IsChecked="{Binding Keyboard.EffectiveKeySteerSnapToFullLock, Mode=TwoWay}" Content="{DynamicResource Page_Steering_SnapToFullLock}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="{DynamicResource Ui_f0f1765411c8}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Name="ResetKeySteerSnapButton" Classes="setting-revert" controls:SettingRevert.Session="{Binding ProfileSession}" controls:SettingRevert.PropertyName="KeySteerSnapToFullLock" Content="{DynamicResource Ui_RestoreSetting}" ToolTip.Tip="{DynamicResource Ui_RestoreSettingHint}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                <StackPanel Spacing="14">
                    <TextBlock Text="{DynamicResource Ui_305b8b980ec1}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <Grid ColumnDefinitions="*,340" RowDefinitions="Auto,Auto" Name="SteeringDynamicsGrid">
                        <StackPanel Grid.Column="0" Spacing="14" Margin="0,0,16,0">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*">
                                    <TextBlock Grid.Column="0" Text="{DynamicResource Ui_7b9f883f9636}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                </Grid>
                                <TextBlock Text="{DynamicResource Ui_a23cb954f828}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                <Grid ColumnDefinitions="*,150,Auto" Margin="0,4,0,0" ColumnSpacing="12">
                                    <Slider Grid.Column="0" Name="SteeringGammaSlider" Value="{Binding Mouse.EffectiveSteeringGamma, Mode=TwoWay}" Minimum="0.1" Maximum="5.0" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center"/>
                                    <NumericUpDown Grid.Column="1" Name="SteeringGammaBox" Value="{Binding Mouse.EffectiveSteeringGamma, Converter={StaticResource NumericConv}, Mode=TwoWay}" Minimum="0.1" Maximum="5.0" Increment="0.05" FormatString="0.00" Width="150" VerticalAlignment="Center" FontSize="13" MinHeight="32"/>
                                    <Button Grid.Column="2" Name="ResetSteeringGammaButton" Classes="setting-revert" controls:SettingRevert.Session="{Binding ProfileSession}" controls:SettingRevert.PropertyName="SteeringGamma" Content="{DynamicResource Ui_RestoreSetting}" ToolTip.Tip="{DynamicResource Ui_RestoreSettingHint}" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                            <Grid ColumnDefinitions="*,150,Auto" ColumnSpacing="12">
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource Ui_e398f7d43a7b}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{DynamicResource Ui_a25fed4fe254}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <NumericUpDown Name="SteeringOffsetBox" Value="{Binding Mouse.EffectiveSteeringOffset, Converter={StaticResource NumericConv}, Mode=TwoWay}" Minimum="-32768" Maximum="32768" Increment="50" FormatString="0" Width="150" HorizontalAlignment="Left" FontSize="13" MinHeight="32" Grid.Column="1" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Name="ResetSteeringOffsetButton" Classes="setting-revert" controls:SettingRevert.Session="{Binding ProfileSession}" controls:SettingRevert.PropertyName="SteeringOffset" Content="{DynamicResource Ui_RestoreSetting}" ToolTip.Tip="{DynamicResource Ui_RestoreSettingHint}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                        <Border Grid.Column="1" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{DynamicResource Ui_2e1c1069f24e}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                                <controls:ResponseCurveControl Name="SteeringResponseCurve" CurvePoints="{Binding Mouse.CurvePoints}" Gamma="{Binding Mouse.EffectiveSteeringGamma}" InputValue="{Binding Mouse.InputValue}" IsBipolar="True" IsMarkerDraggingEnabled="False" Height="200" Width="320"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="6" Padding="16">
                <StackPanel Spacing="14">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <ToggleSwitch Name="LockClampSwitch" IsChecked="{Binding Output.EffectiveUseSteeringLockClamp, Mode=TwoWay}" Content="{DynamicResource Ui_5625033096a6}" FontWeight="SemiBold" FontSize="13"/>
                            <TextBlock Text="{DynamicResource Ui_e574b3bde371}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Column="1" Name="ResetLockClampButton" Classes="setting-revert" controls:SettingRevert.Session="{Binding ProfileSession}" controls:SettingRevert.PropertyName="UseSteeringLockClamp" Content="{DynamicResource Ui_RestoreSetting}" ToolTip.Tip="{DynamicResource Ui_RestoreSettingHint}"/>
                    </Grid>
                    <StackPanel Spacing="12">
                        <Grid ColumnDefinitions="*,150,Auto" ColumnSpacing="12">
                            <TextBlock Text="{DynamicResource Ui_a8ea852dab63}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" Grid.Column="0" VerticalAlignment="Center"/>
                            <NumericUpDown Name="CarSteeringLockBox" Value="{Binding Output.EffectiveCarSteeringLock, Converter={StaticResource NumericConv}, Mode=TwoWay}" IsEnabled="{Binding Output.EffectiveUseSteeringLockClamp}" Minimum="90" Maximum="2520" Increment="10" FormatString="{DynamicResource Ui_NumberDegreesFormat}" Grid.Column="1" VerticalAlignment="Center" Width="150" FontSize="13" MinHeight="32"/>
                            <Button Name="ResetCarLockDegButton" Classes="setting-revert" controls:SettingRevert.Session="{Binding ProfileSession}" controls:SettingRevert.PropertyName="CarSteeringLock" Content="{DynamicResource Ui_RestoreSetting}" ToolTip.Tip="{DynamicResource Ui_RestoreSettingHint}" Grid.Column="2" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="*,150,Auto" ColumnSpacing="12">
                            <TextBlock Text="{DynamicResource Ui_5425325f3103}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" Grid.Column="0" VerticalAlignment="Center"/>
                            <NumericUpDown Name="GlobalSteeringRangeBox" Value="{Binding Output.EffectiveGlobalSteeringRange, Converter={StaticResource NumericConv}, Mode=TwoWay}" IsEnabled="{Binding Output.EffectiveUseSteeringLockClamp}" Minimum="90" Maximum="2520" Increment="10" FormatString="{DynamicResource Ui_NumberDegreesFormat}" Grid.Column="1" VerticalAlignment="Center" Width="150" FontSize="13" MinHeight="32"/>
                            <Button Name="ResetGlobalRangeButton" Classes="setting-revert" controls:SettingRevert.Session="{Binding ProfileSession}" controls:SettingRevert.PropertyName="GlobalSteeringRange" Content="{DynamicResource Ui_RestoreSetting}" ToolTip.Tip="{DynamicResource Ui_RestoreSettingHint}" Grid.Column="2" VerticalAlignment="Center"/>
                        </Grid>

                    </StackPanel>
                </StackPanel>
            </Border>
<controls:FeaturePreview Name="SteeringOffer" Heading="{DynamicResource Offer_Speed}" Summary="{DynamicResource Offer_SpeedInfo}"><controls:FeaturePreview.Sample><StackPanel Spacing="10"><ToggleSwitch Content="{DynamicResource Offer_Enable}" IsChecked="False"/><Grid ColumnDefinitions="*,150" ColumnSpacing="12"><TextBlock Text="{DynamicResource Offer_Minimum}" VerticalAlignment="Center" TextWrapping="Wrap"/><NumericUpDown Grid.Column="1" Value="30" Minimum="0" Maximum="1000"/></Grid><Grid ColumnDefinitions="*,150" ColumnSpacing="12"><TextBlock Text="{DynamicResource Offer_Maximum}" VerticalAlignment="Center" TextWrapping="Wrap"/><NumericUpDown Grid.Column="1" Value="200" Minimum="0" Maximum="1000"/></Grid><Grid ColumnDefinitions="*,150" ColumnSpacing="12"><TextBlock Text="{DynamicResource Offer_Intensity}" VerticalAlignment="Center" TextWrapping="Wrap"/><NumericUpDown Grid.Column="1" Value="50" Minimum="0" Maximum="1000"/></Grid></StackPanel></controls:FeaturePreview.Sample></controls:FeaturePreview>
        </StackPanel>
    </ScrollViewer>
</UserControl>
