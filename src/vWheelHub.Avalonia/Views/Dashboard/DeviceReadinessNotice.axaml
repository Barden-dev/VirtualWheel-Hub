<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SimRacingHub.Application.Features.Dashboard;assembly=vWheelHub.Application"
             x:Class="SimRacingHub.Avalonia.Views.Dashboard.DeviceReadinessNotice"
             x:DataType="vm:DeviceReadinessViewModel" x:CompileBindings="True">
 <Border Name="DeviceReadinessNoticeCard" Classes="hub-card" Padding="14,10">
  <Grid ColumnDefinitions="24,*,Auto">
   <PathIcon Data="{StaticResource IconWarning}" Width="16" Height="16" VerticalAlignment="Top" Margin="0,3,8,0"
             Foreground="{DynamicResource SystemAccentColorBrush}"/>
   <StackPanel Grid.Column="1" Spacing="3" Margin="0,0,12,0">
    <TextBlock Name="ReadinessProblemTitle" Text="{Binding ProblemTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock Text="{Binding ProblemAdvice}" Classes="hub-secondary" TextWrapping="Wrap" FontSize="12"/>
    <TextBlock Name="ReadinessAdministratorNotice" Text="{DynamicResource Output_VJoyFixConsentHint}"
               IsVisible="{Binding ShowAdministratorNotice}" Classes="hub-secondary" TextWrapping="Wrap" FontSize="12"/>
   </StackPanel>
   <Button Name="FixDeviceReadiness" Grid.Column="2" Content="{DynamicResource Readiness_Fix}"
           Command="{Binding FixCommand}" VerticalAlignment="Center"/>
  </Grid>
 </Border>
</UserControl>
