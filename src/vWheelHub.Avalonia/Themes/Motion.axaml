<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared interaction motion. Opt an individual control out with motion-none.
         Keep animation on presentation controls, never on live input values. -->
    <Style Selector="Button:not(.motion-none)">
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="RenderTransform" Value="scale(1)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button:not(.motion-none):pressed">
        <Setter Property="RenderTransform" Value="scale(0.99)" />
    </Style>
    <Style Selector="Button:not(.motion-none) /template/ ContentPresenter">
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.18" Easing="SineEaseInOut" />
                <BrushTransition Property="BorderBrush" Duration="0:0:0.18" Easing="SineEaseInOut" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="ToggleSwitch:not(.motion-none)">
        <Setter Property="KnobTransitions">
            <Transitions>
                <DoubleTransition Property="Canvas.Left" Duration="0:0:0.20" Easing="SineEaseInOut" />
            </Transitions>
        </Setter>
    </Style>
    <!-- One container class covers every existing and future navigation page. -->
    <Style Selector="Panel.hub-pages > Panel[IsVisible=True]:not(.motion-none)">
        <Style.Animations>
            <Animation Duration="0:0:0.22" Easing="SineEaseInOut" FillMode="Forward">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
</Styles>
